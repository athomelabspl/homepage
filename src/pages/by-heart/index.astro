---
import ByHeartAppLayout from '../../layouts/ByHeartAppLayout.astro';
import ByHeartBlogCard from '../../components/blog/ByHeartBlogCard.astro';
import ByHeartOpenGraph from '../../components/seo/ByHeartOpenGraph.astro';
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('by-heart-blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fontLink =
  'https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap';
---

<ByHeartAppLayout
  title="By Heart"
  description="By Heart turns attention into a daily habit. A private, single-player app that learns what your partner needs, then gives you ideas worth trying, things worth learning about them, and small insights along the way."
  bodyClass="home"
>
  <link rel="stylesheet" href={fontLink} slot="head" />
  <ByHeartOpenGraph
    title="By Heart"
    description="By Heart turns attention into a daily habit. A private, single-player app that learns what your partner needs, then gives you ideas worth trying, things worth learning about them, and small insights along the way."
    slot="head"
  />

  <section class="byh-hero">
    <div class="byh-hero-glow"></div>
    <div class="byh-hero-inner">
      <div class="byh-eyebrow">Not a couples app. Not a nag. Not your therapist.</div>
      <h1>Grow closer,<br />one day at a time.</h1>
      <p>
        Ten seconds noticing how today feels. In return: ideas worth trying,
        things worth learning about your partner, and small insights along
        the way, all sized to the day you're actually having.
      </p>
      <div class="byh-store-row">
        <a href="#" class="byh-store-button byh-store-button--filled byh-store-button--soon" rel="noopener noreferrer" aria-disabled="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#fff" aria-hidden="true">
            <path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"></path>
          </svg>
          Coming soon
        </a>
        <a href="#" class="byh-store-button byh-store-button--outline byh-store-button--soon" rel="noopener noreferrer" aria-disabled="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#1c1a17" aria-hidden="true">
            <path d="M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924zm12.207 10.065l3.258-3.238L3.45.195a1.466 1.466 0 0 0-.946-.179l11.04 10.973zm0 2.067l-11 10.933c.298.036.612-.016.906-.183l13.324-7.54-3.23-3.21z"></path>
          </svg>
          Coming soon
        </a>
      </div>
    </div>
    <div class="byh-phones">
      <div class="byh-phone">
        <div class="byh-phone-frame">
          <span class="byh-phone-soon">Coming soon</span>
        </div>
      </div>
      <div class="byh-phone byh-phone--center">
        <div class="byh-phone-frame">
          <span class="byh-phone-soon">Coming soon</span>
        </div>
      </div>
      <div class="byh-phone byh-phone--right">
        <div class="byh-phone-frame">
          <span class="byh-phone-soon">Coming soon</span>
        </div>
      </div>
    </div>
  </section>

  <section class="byh-features">
    <div class="byh-features-header">
      <div class="byh-eyebrow">What it does for you</div>
      <h2>Always know the right thing to do next.</h2>
    </div>
    <div class="byh-feature-grid">
      <div class="byh-feature-card">
        <svg class="byh-feature-icon" viewBox="0 0 30 30" fill="none" aria-hidden="true">
          <path
            d="M6 8.5C6 6.6 7.6 5 9.5 5h11C22.4 5 24 6.6 24 8.5v8c0 1.9-1.6 3.5-3.5 3.5H12l-5 4.5v-4.5C6.4 19.4 6 18 6 16.5v-8Z"
            stroke="#0FAE9D" stroke-width="1.8" stroke-linejoin="round"></path>
          <line x1="10.5" y1="10.5" x2="19.5" y2="10.5" stroke="#0FAE9D" stroke-width="1.8" stroke-linecap="round"></line>
          <line x1="10.5" y1="14.5" x2="16.5" y2="14.5" stroke="#0FAE9D" stroke-width="1.8" stroke-linecap="round"></line>
        </svg>
        <h3>One check-in, a few ideas back</h3>
        <p>
          One tap says how today's going, and what comes back matches it:
          playful on a good day, quieter on a hard one. Running on empty?
          Say so, and get a guilt-free rest day instead. No streak to
          protect.
        </p>
      </div>
      <div class="byh-feature-card">
        <svg class="byh-feature-icon" viewBox="0 0 30 30" fill="none" aria-hidden="true">
          <path
            d="M15 25.5S5 19 5 12.2C5 8.6 7.8 6 11 6c2 0 3.6 1 4 2.3.4-1.3 2-2.3 4-2.3 3.2 0 6 2.6 6 6.2 0 6.8-10 13.3-10 13.3Z"
            stroke="#FF8A65" stroke-width="1.8" stroke-linejoin="round"></path>
        </svg>
        <h3>Suggestions that know them, not "people"</h3>
        <p>
          Never scramble for a generic idea again. Get "grab her the iced
          half-sugar from Karmelicka today," built from their coffee order,
          their comfort movie, what helps after a bad day. Not "do
          something nice tonight."
        </p>
      </div>
      <div class="byh-feature-card">
        <svg class="byh-feature-icon" viewBox="0 0 30 30" fill="none" aria-hidden="true">
          <rect x="7" y="5.5" width="14" height="19" rx="2" stroke="#0FAE9D" stroke-width="1.8"></rect>
          <line x1="10" y1="11" x2="18" y2="11" stroke="#0FAE9D" stroke-width="1.8" stroke-linecap="round"></line>
          <line x1="10" y1="15" x2="18" y2="15" stroke="#0FAE9D" stroke-width="1.8" stroke-linecap="round"></line>
          <line x1="10" y1="19" x2="14.5" y2="19" stroke="#0FAE9D" stroke-width="1.8" stroke-linecap="round"></line>
          <path d="M20 20.5l3.5 3.5L27 20.5l-3.5-3.5-3.5 3.5Z" fill="#0FAE9D"></path>
        </svg>
        <h3>Notes that turn a gesture into "they know me"</h3>
        <p>
          Do the thing in a way that actually lands: every detail you've
          noticed surfaces right when it matters, like only iced, half
          sugar. Don't know something yet? It becomes a small, easy
          question worth asking instead.
        </p>
      </div>
      <div class="byh-feature-card">
        <svg class="byh-feature-icon" viewBox="0 0 30 30" fill="none" aria-hidden="true">
          <rect x="6" y="8.5" width="18" height="15" rx="2.5" stroke="#FF8A65" stroke-width="1.8"></rect>
          <line x1="6" y1="13" x2="24" y2="13" stroke="#FF8A65" stroke-width="1.8"></line>
          <line x1="10.5" y1="6" x2="10.5" y2="10" stroke="#FF8A65" stroke-width="1.8" stroke-linecap="round"></line>
          <line x1="19.5" y1="6" x2="19.5" y2="10" stroke="#FF8A65" stroke-width="1.8" stroke-linecap="round"></line>
          <circle cx="15" cy="18" r="1.6" fill="#FF8A65"></circle>
        </svg>
        <h3>Never caught off guard by a date</h3>
        <p>
          Trade the panicked evening for a plan. Big dates start two weeks
          out, split into small steps: decide, get it, write the card. Short
          on time? It says so kindly: a dinner reservation still makes it a
          great birthday.
        </p>
      </div>
      <div class="byh-feature-card">
        <svg class="byh-feature-icon" viewBox="0 0 30 30" fill="none" aria-hidden="true">
          <path d="M8 22c0-8.8 6.2-15 15-15 0 8.8-6.2 15-15 15Z" stroke="#0FAE9D" stroke-width="1.8" stroke-linejoin="round"></path>
          <path d="M8 22c3.3-3.3 6.7-6.7 11-11" stroke="#0FAE9D" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
        <h3>Gentler exactly when things get hard</h3>
        <p>
          Never get a chirpy suggestion on a hard week. After a rough
          stretch, what you're offered quietly shifts to what actually
          helps: space, patience, being taken seriously. No announcement,
          no guilt trip.
        </p>
      </div>
      <div class="byh-feature-card">
        <svg class="byh-feature-icon" viewBox="0 0 30 30" fill="none" aria-hidden="true">
          <path d="M6 23.5V21l5.5-6 4.5 4 8-9.5" stroke="#FF8A65" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M18.5 8h5v5" stroke="#FF8A65" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          <line x1="6" y1="23.5" x2="24" y2="23.5" stroke="#FF8A65" stroke-width="1.8" stroke-linecap="round"></line>
        </svg>
        <h3>Proof it's working, not pressure</h3>
        <p>
          Watch it add up: a private 60-day view of how things have felt,
          and the moments worth keeping. No streaks, no badges, no scores.
          Skip a day and nothing resets. It just waits for you.
        </p>
      </div>
      <div class="byh-feature-card byh-feature-card--wide">
        <svg class="byh-feature-icon" viewBox="0 0 30 30" fill="none" aria-hidden="true">
          <rect x="7.5" y="13.5" width="15" height="11" rx="2.5" stroke="#0FAE9D" stroke-width="1.8"></rect>
          <path d="M11 13.5v-3a4 4 0 0 1 8 0v3" stroke="#0FAE9D" stroke-width="1.8" stroke-linecap="round"></path>
          <circle cx="15" cy="18.5" r="1.6" fill="#0FAE9D"></circle>
        </svg>
        <h3>Private from the look over your shoulder</h3>
        <p>
          Use it beside them on the sofa without a second thought. App Lock
          keeps it behind your face or thumbprint; Discrete Mode makes
          notifications read like routine reminders. Nothing posted,
          compared, or shared, and no participation required from them,
          ever.
        </p>
      </div>
    </div>
  </section>

  {
    recentPosts.length > 0 && (
      <section class="byh-home-blog">
        <div class="byh-home-blog-header">
          <h2>From the blog</h2>
          <a href="/by-heart/blog/">Read the blog</a>
        </div>
        <div class="byh-blog-grid byh-blog-grid--home">
          {recentPosts.map((post) => (
            <ByHeartBlogCard
              id={post.id}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              body={post.body}
              cover={post.data.cover}
            />
          ))}
        </div>
      </section>
    )
  }

  <section class="byh-cta-band">
    <h2>Start today.</h2>
    <p>Free to download. Two minutes a day.</p>
    <div class="byh-store-row" style="margin-bottom: 0">
      <a href="#" class="byh-store-button byh-store-button--light byh-store-button--soon" rel="noopener noreferrer" aria-disabled="true">Coming soon</a>
      <a href="#" class="byh-store-button byh-store-button--light-outline byh-store-button--soon" rel="noopener noreferrer" aria-disabled="true">Coming soon</a>
    </div>
  </section>
</ByHeartAppLayout>
