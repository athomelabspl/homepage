---
import ByHeartAppLayout from '../../layouts/ByHeartAppLayout.astro';
import ByHeartBlogCard from '../../components/blog/ByHeartBlogCard.astro';
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('by-heart-blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fontLink =
  'https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap';
---

<ByHeartAppLayout
  title="By Heart"
  description="By Heart turns attention into a daily habit. A private, single-player app that learns what your partner needs, then gives you one small, specific thing to do today."
  bodyClass="home"
>
  <link rel="stylesheet" href={fontLink} slot="head" />

  <section class="byh-hero">
    <div class="byh-hero-glow"></div>
    <div class="byh-hero-inner">
      <div class="byh-eyebrow">A private habit, just for you</div>
      <h1>Grow closer,<br />one day at a time.</h1>
      <p>
        By Heart turns attention into a daily habit. It learns what your
        partner needs, then gives you one small, specific thing to do today.
      </p>
      <div class="byh-store-row">
        <a href="#" class="byh-store-button byh-store-button--filled" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 384 512" fill="#fff" aria-hidden="true">
            <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-19.5-27.9-49-43.1-88.9-46.7-33.4-2.9-70.6 19.4-83.8 19.4-13.5 0-46.3-18.9-73.9-18.4-51.7.9-100.5 30-127.8 76.7-52.4 90.9-13.5 226 39.1 300.2 24.4 34.4 53.9 72.6 92.5 71.2 36.4-1.4 50.4-23.7 94.7-23.7 44.1 0 56.9 23.7 95.4 22.9 39.1-.6 63.7-34.1 88.1-68.4 24.5-35.1 34.6-69 35-71-.9-.3-67.3-25.7-67.4-101.4zM255.6 68.5c19.8-24.5 33.2-58.4 29.6-92.5-28.5 1.2-63.1 19-83.9 43.4-17.9 20.8-33.6 54.4-29.4 86.4 31.1 2.4 62.8-15.8 83.7-37.3z"></path>
          </svg>
          App Store
        </a>
        <a href="#" class="byh-store-button byh-store-button--outline" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 512 512" fill="#1c1a17" aria-hidden="true">
            <path d="M325.3 234.3L104.6 13l280.8 161.2-60.1 60.1zM47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0zm425.2 225.6l-58.9-34-65.7 64.5 65.7 64.5 60-34c17.8-11.1 17.8-45.8-1.1-60.9zM104.6 499l280.8-161.2-60.1-60.1L104.6 499z"></path>
          </svg>
          Google Play
        </a>
      </div>
    </div>
    <div class="byh-phones">
      <div class="byh-phone">
        <div class="byh-phone-frame"></div>
      </div>
      <div class="byh-phone byh-phone--center">
        <div class="byh-phone-frame"></div>
      </div>
      <div class="byh-phone byh-phone--right">
        <div class="byh-phone-frame"></div>
      </div>
    </div>
  </section>

  <section class="byh-features">
    <div class="byh-feature-grid">
      <div class="byh-feature-card">
        <svg class="byh-feature-icon" viewBox="0 0 30 30" fill="none" aria-hidden="true">
          <path
            d="M6 8.5C6 6.6 7.6 5 9.5 5h11C22.4 5 24 6.6 24 8.5v8c0 1.9-1.6 3.5-3.5 3.5H12l-5 4.5v-4.5C6.4 19.4 6 18 6 16.5v-8Z"
            stroke="#0FAE9D" stroke-width="1.8" stroke-linejoin="round"></path>
          <line x1="10.5" y1="10.5" x2="19.5" y2="10.5" stroke="#0FAE9D" stroke-width="1.8" stroke-linecap="round"></line>
          <line x1="10.5" y1="14.5" x2="16.5" y2="14.5" stroke="#0FAE9D" stroke-width="1.8" stroke-linecap="round"></line>
        </svg>
        <h3>Today's one thing</h3>
        <p>
          One small, specific suggestion each day, sized to how things feel
          right now and built from what you've told the app about your
          partner.
        </p>
      </div>
      <div class="byh-feature-card">
        <svg class="byh-feature-icon" viewBox="0 0 30 30" fill="none" aria-hidden="true">
          <rect x="7.5" y="13.5" width="15" height="11" rx="2.5" stroke="#FF8A65" stroke-width="1.8"></rect>
          <path d="M11 13.5v-3a4 4 0 0 1 8 0v3" stroke="#FF8A65" stroke-width="1.8" stroke-linecap="round"></path>
          <circle cx="15" cy="18.5" r="1.6" fill="#FF8A65"></circle>
        </svg>
        <h3>Private by design</h3>
        <p>
          App Lock and Discrete Mode keep By Heart yours alone, even on a
          shared phone. Your partner never sees the app or knows it's there.
        </p>
      </div>
      <div class="byh-feature-card">
        <svg class="byh-feature-icon" viewBox="0 0 30 30" fill="none" aria-hidden="true">
          <path d="M6 23.5V21l5.5-6 4.5 4 8-9.5" stroke="#0FAE9D" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M18.5 8h5v5" stroke="#0FAE9D" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          <line x1="6" y1="23.5" x2="24" y2="23.5" stroke="#0FAE9D" stroke-width="1.8" stroke-linecap="round"></line>
        </svg>
        <h3>A private record</h3>
        <p>
          Look back on the relationship's emotional weather and the moments
          worth keeping — visible to no one but you.
        </p>
      </div>
    </div>
  </section>

  {
    recentPosts.length > 0 && (
      <section class="byh-home-blog">
        <div class="byh-home-blog-header">
          <h2>From the blog</h2>
          <a href="/by-heart/blog/">Read the blog</a>
        </div>
        <div class="byh-blog-grid byh-blog-grid--home">
          {recentPosts.map((post) => (
            <ByHeartBlogCard
              id={post.id}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              body={post.body}
            />
          ))}
        </div>
      </section>
    )
  }

  <section class="byh-cta-band">
    <h2>Start today.</h2>
    <p>Free to download. Two minutes a day.</p>
    <div class="byh-store-row" style="margin-bottom: 0">
      <a href="#" class="byh-store-button byh-store-button--light" rel="noopener noreferrer">App Store</a>
      <a href="#" class="byh-store-button byh-store-button--light-outline" rel="noopener noreferrer">Google Play</a>
    </div>
  </section>
</ByHeartAppLayout>
