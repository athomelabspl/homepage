---
import ByHeartAppLayout from '../../layouts/ByHeartAppLayout.astro';
import ByHeartBlogCard from '../../components/blog/ByHeartBlogCard.astro';
import ByHeartOpenGraph from '../../components/seo/ByHeartOpenGraph.astro';
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('by-heart-blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fontLink =
  'https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap';
---

<ByHeartAppLayout
  title="By Heart"
  description="By Heart turns attention into a daily habit. A private, single-player app that learns what your partner needs, then gives you ideas worth trying, things worth learning about them, and small insights along the way."
  bodyClass="home"
>
  <link rel="stylesheet" href={fontLink} slot="head" />
  <ByHeartOpenGraph
    title="By Heart"
    description="By Heart turns attention into a daily habit. A private, single-player app that learns what your partner needs, then gives you ideas worth trying, things worth learning about them, and small insights along the way."
    slot="head"
  />

  <section class="byh-hero">
    <div class="byh-hero-glow"></div>
    <div class="byh-hero-inner">
      <div class="byh-eyebrow">Not another couples app.</div>
      <h1>Turn your life<br />into a rom-com,<br />with you as the lead.</h1>
      <p>
        Make your person feel loved every day with
        well-intended-yet-not-overbearing-best-friend-quality advice,
        always in your pocket.
      </p>
      <div class="byh-store-row">
        <a href="#" class="byh-store-button byh-store-button--filled byh-store-button--soon" rel="noopener noreferrer" aria-disabled="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#fff" aria-hidden="true">
            <path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"></path>
          </svg>
          Coming soon
        </a>
        <a href="#" class="byh-store-button byh-store-button--outline byh-store-button--soon" rel="noopener noreferrer" aria-disabled="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#1c1a17" aria-hidden="true">
            <path d="M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924zm12.207 10.065l3.258-3.238L3.45.195a1.466 1.466 0 0 0-.946-.179l11.04 10.973zm0 2.067l-11 10.933c.298.036.612-.016.906-.183l13.324-7.54-3.23-3.21z"></path>
          </svg>
          Coming soon
        </a>
      </div>
    </div>
    <div class="byh-phones">
      <div class="byh-phone">
        <div class="byh-phone-frame">
          <span class="byh-phone-soon">Coming soon</span>
        </div>
      </div>
      <div class="byh-phone byh-phone--center">
        <div class="byh-phone-frame">
          <span class="byh-phone-soon">Coming soon</span>
        </div>
      </div>
      <div class="byh-phone byh-phone--right">
        <div class="byh-phone-frame">
          <span class="byh-phone-soon">Coming soon</span>
        </div>
      </div>
    </div>
  </section>

  <section class="byh-features">
    <div class="byh-features-header">
      <div class="byh-eyebrow">HOW BY HEART IMPROVES YOUR RELATIONSHIP</div>
      <h2>Never forget about everyday romance.<br />Or your anniversary.</h2>
    </div>
    <div class="byh-feature-grid">
      <div class="byh-feature-card">
        <svg class="byh-feature-icon" viewBox="0 0 256 256" fill="currentColor" style="color: #0FAE9D" aria-hidden="true">
          <path d="M128,24A104,104,0,0,0,36.18,176.88L24.83,210.93a16,16,0,0,0,20.24,20.24l34.05-11.35A104,104,0,1,0,128,24Zm0,192a87.87,87.87,0,0,1-44.06-11.81,8,8,0,0,0-6.54-.67L40,216,52.47,178.6a8,8,0,0,0-.66-6.54A88,88,0,1,1,128,216Z"></path>
        </svg>
        <h3>Get ideas that match your day</h3>
        <p>
          Tap how you're feeling and get something to do for them that
          fits your mood.
          <br /><br />
          Running on empty? Tap that too, and skip today guilt-free.
        </p>
      </div>
      <div class="byh-feature-card">
        <svg class="byh-feature-icon" viewBox="0 0 256 256" fill="currentColor" style="color: #FF8A65" aria-hidden="true">
          <path d="M178,40c-20.65,0-38.73,8.88-50,23.89C116.73,48.88,98.65,40,78,40a62.07,62.07,0,0,0-62,62c0,70,103.79,126.66,108.21,129a8,8,0,0,0,7.58,0C136.21,228.66,240,172,240,102A62.07,62.07,0,0,0,178,40ZM128,214.8C109.74,204.16,32,155.69,32,102A46.06,46.06,0,0,1,78,56c19.45,0,35.78,10.36,42.6,27a8,8,0,0,0,14.8,0c6.82-16.67,23.15-27,42.6-27a46.06,46.06,0,0,1,46,46C224,155.61,146.24,204.15,128,214.8Z"></path>
        </svg>
        <h3>Don't forget what matters</h3>
        <p>
          Tell it her coffee order once, and you'll get "her iced
          oat-milk latte, extra shot," not "something nice."
          <br /><br />
          You already know these things. Now they actually get used.
        </p>
      </div>
      <div class="byh-feature-card">
        <svg class="byh-feature-icon" viewBox="0 0 256 256" fill="currentColor" style="color: #0FAE9D" aria-hidden="true">
          <path d="M229.66,58.34l-32-32a8,8,0,0,0-11.32,0l-96,96A8,8,0,0,0,88,128v32a8,8,0,0,0,8,8h32a8,8,0,0,0,5.66-2.34l96-96A8,8,0,0,0,229.66,58.34ZM124.69,152H104V131.31l64-64L188.69,88ZM200,76.69,179.31,56,192,43.31,212.69,64ZM224,128v80a16,16,0,0,1-16,16H48a16,16,0,0,1-16-16V48A16,16,0,0,1,48,32h80a8,8,0,0,1,0,16H48V208H208V128a8,8,0,0,1,16,0Z"></path>
        </svg>
        <h3>Make every gesture actually land</h3>
        <p>
          You'll see the detail exactly when you need it, like only iced,
          half sugar.
          <br /><br />
          Don't know something yet? You get a nudge to ask, not a blank
          page.
        </p>
      </div>
      <div class="byh-feature-card">
        <svg class="byh-feature-icon" viewBox="0 0 256 256" fill="currentColor" style="color: #FF8A65" aria-hidden="true">
          <path d="M208,32H184V24a8,8,0,0,0-16,0v8H88V24a8,8,0,0,0-16,0v8H48A16,16,0,0,0,32,48V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V48A16,16,0,0,0,208,32Zm0,176H48V48H72v8a8,8,0,0,0,16,0V48h80v8a8,8,0,0,0,16,0V48h24V208ZM152,88a31.91,31.91,0,0,0-24,10.86A32,32,0,0,0,72,120c0,36.52,50.28,62.08,52.42,63.16a8,8,0,0,0,7.16,0C133.72,182.08,184,156.52,184,120A32,32,0,0,0,152,88Zm-24,78.93c-13.79-7.79-40-26.75-40-46.93a16,16,0,0,1,32,0,8,8,0,0,0,16,0,16,16,0,0,1,32,0C168,140.19,141.79,159.15,128,166.93Z"></path>
        </svg>
        <h3>Turn big dates into a plan</h3>
        <p>
          You get a two-week countdown before every big date, broken into
          steps you can actually finish.
          <br /><br />
          Running short on time? Book the dinner. It still counts.
        </p>
      </div>
      <div class="byh-feature-card">
        <svg class="byh-feature-icon" viewBox="0 0 256 256" fill="currentColor" style="color: #0FAE9D" aria-hidden="true">
          <path d="M223.45,40.07a8,8,0,0,0-7.52-7.52C139.8,28.08,78.82,51,52.82,94a87.09,87.09,0,0,0-12.76,49c.57,15.92,5.21,32,13.79,47.85l-19.51,19.5a8,8,0,0,0,11.32,11.32l19.5-19.51C81,210.73,97.09,215.37,113,215.94q1.67.06,3.33.06A86.93,86.93,0,0,0,162,203.18C205,177.18,227.93,116.21,223.45,40.07ZM153.75,189.5c-22.75,13.78-49.68,14-76.71.77l88.63-88.62a8,8,0,0,0-11.32-11.32L65.73,179c-13.19-27-13-54,.77-76.71,22.09-36.47,74.6-56.44,141.31-54.06C210.2,114.89,190.22,167.41,153.75,189.5Z"></path>
        </svg>
        <h3>Get gentler ideas on hard weeks</h3>
        <p>
          Had a rough week? You get quieter ideas: give space, listen,
          take it seriously.
          <br /><br />
          No lecture, no guilt trip. Just what actually helps.
        </p>
      </div>
      <div class="byh-feature-card">
        <svg class="byh-feature-icon" viewBox="0 0 256 256" fill="currentColor" style="color: #FF8A65" aria-hidden="true">
          <path d="M232,208a8,8,0,0,1-8,8H32a8,8,0,0,1-8-8V48a8,8,0,0,1,16,0V156.69l50.34-50.35a8,8,0,0,1,11.32,0L128,132.69,180.69,80H160a8,8,0,0,1,0-16h40a8,8,0,0,1,8,8v40a8,8,0,0,1-16,0V91.31l-58.34,58.35a8,8,0,0,1-11.32,0L96,123.31l-56,56V200H224A8,8,0,0,1,232,208Z"></path>
        </svg>
        <h3>Watch your effort add up</h3>
        <p>
          You get 60 days of how things have actually felt, in one
          private view.
          <br /><br />
          No streaks to lose. Skip a day and nothing resets.
        </p>
      </div>
      <div class="byh-feature-card byh-feature-card--wide">
        <svg class="byh-feature-icon" viewBox="0 0 256 256" fill="currentColor" style="color: #0FAE9D" aria-hidden="true">
          <path d="M128,112a28,28,0,0,0-8,54.83V184a8,8,0,0,0,16,0V166.83A28,28,0,0,0,128,112Zm0,40a12,12,0,1,1,12-12A12,12,0,0,1,128,152Zm80-72H176V56a48,48,0,0,0-96,0V80H48A16,16,0,0,0,32,96V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V96A16,16,0,0,0,208,80ZM96,56a32,32,0,0,1,64,0V80H96ZM208,208H48V96H208V208Z"></path>
        </svg>
        <h3>Keep it private, no matter what</h3>
        <p>
          Only your face or thumbprint gets you in.
          <br /><br />
          Your notes and details stay stored on your device, never
          posted, compared, or shared.
        </p>
      </div>
    </div>
  </section>

  {
    recentPosts.length > 0 && (
      <section class="byh-home-blog">
        <div class="byh-home-blog-header">
          <h2>From the blog</h2>
          <a href="/by-heart/blog/">Read the blog</a>
        </div>
        <div class="byh-blog-grid byh-blog-grid--home">
          {recentPosts.map((post) => (
            <ByHeartBlogCard
              id={post.id}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              body={post.body}
              cover={post.data.cover}
            />
          ))}
        </div>
      </section>
    )
  }

  <section class="byh-cta-band">
    <h2>Start today.</h2>
    <p>Free to download. Two minutes a day.</p>
    <div class="byh-store-row" style="margin-bottom: 0">
      <a href="#" class="byh-store-button byh-store-button--light byh-store-button--soon" rel="noopener noreferrer" aria-disabled="true">Coming soon</a>
      <a href="#" class="byh-store-button byh-store-button--light-outline byh-store-button--soon" rel="noopener noreferrer" aria-disabled="true">Coming soon</a>
    </div>
  </section>
</ByHeartAppLayout>
