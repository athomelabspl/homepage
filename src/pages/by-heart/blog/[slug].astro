---
import ByHeartAppLayout from '../../../layouts/ByHeartAppLayout.astro';
import ByHeartOpenGraph from '../../../components/seo/ByHeartOpenGraph.astro';
import ByHeartBlogPostingSchema from '../../../components/seo/ByHeartBlogPostingSchema.astro';
import FAQPageSchema from '../../../components/seo/FAQPageSchema.astro';
import FAQ from '../../../components/mdx/FAQ.astro';
import AISummary from '../../../components/mdx/AISummary.astro';
import BlogCover from '../../../components/blog/BlogCover.astro';
import BlogFigure from '../../../components/blog/BlogFigure.astro';
import { getCollection, render } from 'astro:content';
import { readingTimeMinutes, postSlug } from '../../../utils/blog';
import { formatByHeartBlogDate } from '../../../utils/byHeartBlog';

export async function getStaticPaths() {
  const posts = await getCollection('by-heart-blog');
  return posts.map((post) => ({
    params: { slug: postSlug(post.id) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const minutes = readingTimeMinutes(post.body);
const faqItems = post.data.faq ?? [];

const site = Astro.site?.href.replace(/\/$/, '') ?? 'https://athomelabs.eu';
const pagePath = `/by-heart/blog/${postSlug(post.id)}/`;
const pageUrl = `${site}${pagePath}`;

const fontLink =
  'https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,600;1,500&family=Work+Sans:wght@400;500;600;700&display=swap';
---

<ByHeartAppLayout title={post.data.title} description={post.data.description} bodyClass="page">
  <link rel="stylesheet" href={fontLink} slot="head" />
  <ByHeartOpenGraph
    title={post.data.title}
    description={post.data.description}
    url={pageUrl}
    image={post.data.cover?.src}
    imageAlt={post.data.cover?.alt}
    type="article"
    slot="head"
  />
  <ByHeartBlogPostingSchema
    title={post.data.title}
    description={post.data.description}
    url={pageUrl}
    datePublished={post.data.pubDate}
    slot="head"
  />
  {faqItems.length > 0 && <FAQPageSchema items={faqItems} slot="head" />}

  <div class="byh-article-page">
    <a class="byh-back-link" href="/by-heart/blog/">
      <svg width="14" height="14" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
        <path d="M224,128a8,8,0,0,1-8,8H59.31l58.35,58.34a8,8,0,0,1-11.32,11.32l-72-72a8,8,0,0,1,0-11.32l72-72a8,8,0,0,1,11.32,11.32L59.31,120H216A8,8,0,0,1,224,128Z" />
      </svg>
      Blog
    </a>

    <article class="byh-article">
      <header class="byh-article-header">
        <div class="byh-eyebrow">{post.data.category}</div>
        <h1>{post.data.title}</h1>
        <p class="byh-article-dek">{post.data.description}</p>
        <div class="byh-byline">
          <img
            class="byh-byline-avatar"
            src="/by-heart/logo.svg"
            alt=""
            width="34"
            height="34"
            aria-hidden="true"
          />
          <div class="byh-byline-text">
            <div class="byh-byline-name">{post.data.author}</div>
            <div class="byh-byline-meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {formatByHeartBlogDate(post.data.pubDate)}
              </time>
              <span aria-hidden="true"> · </span>
              <span>{minutes} min read</span>
            </div>
          </div>
        </div>
      </header>

      {
        post.data.cover ? (
          <BlogCover cover={post.data.cover} />
        ) : (
          <div class="byh-article-hero" role="img" aria-label="Article image">
            <span>Article image</span>
          </div>
        )
      }

      <div class="byh-article-body">
        <Content components={{ AISummary, BlogFigure }} />
      </div>

      {
        faqItems.length > 0 && (
          <FAQ items={faqItems} heading="Frequently asked questions" class="byh-faq" />
        )
      }

      <div class="byh-article-cta">
        <p>By Heart is coming soon.</p>
        <a href="/by-heart/">Learn more</a>
      </div>
    </article>
  </div>
</ByHeartAppLayout>
