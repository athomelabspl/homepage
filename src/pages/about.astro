---
import StudioLayout from '../layouts/StudioLayout.astro';
---

<StudioLayout
  title="About us"
  description="About At Home Labs — a small app studio building focused tools."
>
  <h1>About us</h1>
  <p class="bio">
    We're a small app studio based in Poland. We like focused, calm products
    that respect your time.
  </p>
  <p class="bio">
    If you want to collaborate, share an idea, or report an issue with one of
    our apps:
  </p>
  <a
    href="mailto:athomelabs.studio@gmail.com"
    class="btn-studio btn-studio--primary"
  >
    Get in touch
  </a>
</StudioLayout>
