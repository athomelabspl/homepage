---
import AppLayout from '../../../../layouts/AppLayout.astro';
import Canonical from '../../../../components/seo/Canonical.astro';
import OpenGraph from '../../../../components/seo/OpenGraph.astro';
import FAQPageSchema from '../../../../components/seo/FAQPageSchema.astro';
import FAQ from '../../../../components/mdx/FAQ.astro';
import PhosphorIcon from '../../../../components/icons/PhosphorIcon.astro';
import { brands } from '../../../../config/brands';
import {
  getBreakupDownloadUrl,
  storePlacements,
} from '../../../../utils/storeLinks';

const title = 'Should I Do No Contact? Free Quiz';
const description =
  'Not sure if you need full silence or just tighter boundaries? Four quick questions, including if you share kids, a pet, or a lease.';

const brand = brands['breakup-reset'];
const pagePath = '/breakup-reset/blog/en/should-i-do-no-contact-quiz/';
const pageUrl = `https://athomelabs.eu${pagePath}`;

const downloadUrl = getBreakupDownloadUrl(storePlacements.quizNoContact);

const faqItems = [
  {
    question: 'Should everyone do no contact after a breakup?',
    answer:
      'No. For a lot of people, less contact helps. If you share kids, a workplace, or a lease, full silence may not be realistic. The goal is usually less contact than you have now, with clearer boundaries where contact has to stay.',
  },
  {
    question: 'Can I do no contact if we have kids?',
    answer:
      'You cannot vanish, but you can do logistics-only contact. Pickup times, school, health. Keep it short. Do not work through the relationship in the co-parenting chat.',
  },
  {
    question: 'What if we share a pet?',
    answer:
      'Same idea: handoffs, vet visits, who has them this week. Not daily photo updates to stay close. If shared custody keeps reopening the wound, it is okay to rethink the arrangement.',
  },
  {
    question: 'Does checking their Instagram count as contact?',
    answer:
      'For healing, usually yes. Your body often reacts the same whether you text or scroll. "Technically not messaging" while checking their profile every day is not much of a break.',
  },
  {
    question: 'Is no contact just a trick to get my ex back?',
    answer:
      'That is how it gets sold online. Distance helps most when you are doing it for your own recovery, not as a tactic to make them miss you.',
  },
  {
    question: 'What if I already texted them?',
    answer:
      'Note what triggered it and keep going. One message does not mean you are back at zero.',
  },
  {
    question: 'What if we still live together for now?',
    answer:
      'Pick Housing or belongings in the quiz. Keep talk to move-out logistics until someone has a new place. It is temporary tight boundaries, not forever.',
  },
  {
    question: 'I do not feel safe around my ex. Is this quiz enough?',
    answer:
      'No. If you do not feel safe, distance is not optional. Get support from someone you trust or a professional. This quiz is for the messy middle, not danger.',
  },
];

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Should I Do No Contact? Free Quiz',
  url: pageUrl,
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  description:
    'A short quiz to see whether you need full no contact, tighter low contact, or less contact than you have now, including breakups with kids, pets, or shared logistics.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  author: {
    '@type': 'Organization',
    name: brand.name,
    url: 'https://athomelabs.eu/breakup-reset/',
  },
};

const questionsPathA = [
  'In the past week, after you texted, called, or saw them, did you feel worse for hours, not just a few minutes?',
  'Do you check their socials, reread old messages, or ask mutual friends how they are doing?',
  'Is part of you still hoping they will change their mind or come back?',
  'When you reach out, is it usually because you miss the feeling of them replying, not because you actually need something?',
];

const questionsPathB = [
  'Do practical messages (pickup times, rent, pet handoffs, work stuff) often turn into relationship talk or arguments?',
  'Do you message them about logistics more often than you really need to?',
  'After you have to contact them, do you replay the conversation, refresh for a reply, or feel worse for hours?',
  'Are you using "we have to coordinate" as a reason to stay emotionally close?',
];

const constraints = [
  { id: 'none', label: 'Nothing practical' },
  { id: 'kids', label: 'Kids or co-parenting' },
  { id: 'pets', label: 'A shared pet' },
  { id: 'housing', label: 'Housing or belongings' },
  { id: 'work', label: 'Work or school' },
  { id: 'other', label: 'Other logistics' },
];

const constraintTips: Record<string, string> = {
  kids: 'Keep it to pickups, school, and health. Brief and practical. Do not process the breakup in the co-parenting thread. Save that for a friend or your journal.',
  pets: 'Handoffs and vet stuff only. Skip the "just wanted to say they miss you" texts. If every swap leaves you gutted, shared custody might be hurting you more than helping. One person keeping the pet, or a friend handling handoffs, is allowed.',
  housing:
    'Agree times to grab your things. No "can we talk about us" while someone is still moving out.',
  work: 'Work scope only. No after-hours chat that is really about the two of you.',
  other: 'Money, legal, shared bills: facts only. No extra messages to fill the silence.',
};

const landingIllustration = {
  src: '/breakup-reset/quiz/no-contact-quiz-landing.svg',
  alt: 'A barrier gate beside a winding path',
  width: 300,
  height: 250,
};

const resultImages = {
  moreDistance: {
    src: '/breakup-reset/quiz/friends-with-ex-quiz-result-not-ready.png',
    alt: 'A smartphone lying face-down on a textured brown blanket, seen from above',
    width: 512,
    height: 341,
    intrinsicWidth: 1024,
  },
  ok: {
    src: '/breakup-reset/quiz/friends-with-ex-quiz-result-ready.png',
    alt: 'A wooden window swung open on a sunlit green wall',
    width: 512,
    height: 341,
    intrinsicWidth: 1024,
  },
};

const ogTitle = `${title} | ${brand.name}`;

const relatedArticles = [
  {
    href: '/breakup-reset/blog/en/should-you-do-no-contact/',
    title: 'Should You Do No Contact? An Honest Guide for When You Are Not Sure',
  },
  {
    href: '/breakup-reset/blog/en/no-contact-after-breakup/',
    title: "No Contact After a Breakup: What It Does (and What It Doesn't)",
  },
  {
    href: '/breakup-reset/blog/en/keeping-no-contact-after-breakup/',
    title: 'Why Keeping No Contact Feels So Hard',
  },
  {
    href: '/breakup-reset/blog/en/friends-with-ex-quiz/',
    title: 'Am I Ready To Be Friends with My Ex? Free Quiz',
  },
];

const questionCount = questionsPathA.length;
---

<AppLayout
  {title}
  {description}
  bodyClass="page no-contact-quiz-page"
  showSmartBanner
>
  <Canonical slot="head" />
  <OpenGraph
    slot="head"
    title={ogTitle}
    description={description}
    url={pageUrl}
    image="/breakup-reset/blog/covers/should-you-do-no-contact.jpg"
    imageWidth={1200}
    imageHeight={800}
    imageAlt="Aerial view of a person standing at a fork in a forest path"
  />
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} slot="head" />
  <FAQPageSchema items={faqItems} slot="head" />

  <article class="no-contact-quiz" aria-labelledby="ncq-title">
    <header class="no-contact-quiz-header">
      <h1 id="ncq-title" class="no-contact-quiz-title">
        Should I Do No Contact? Free Quiz
      </h1>
    </header>

    <div
      class="fc-progress-bar"
      id="fc-progress-bar"
      role="progressbar"
      aria-valuemin={0}
      aria-valuemax={questionCount}
      aria-valuenow={0}
      aria-label="Quiz progress"
      hidden
    >
      <ol class="fc-progress-steps">
        {
          Array.from({ length: questionCount }, (_, index) => (
            <li class="fc-progress-step" data-step={index}>
              <span class="fc-progress-step-marker" aria-hidden="true" />
              <span class="fc-progress-step-label">Question {index + 1}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <div
      class="no-contact-quiz-card"
      id="no-contact-quiz"
      data-download-url={downloadUrl}
    >
      <div class="fc-panels-viewport">
        <section
          class="fc-panel fc-panel--active"
          data-panel="landing"
          aria-labelledby="ncq-landing-heading"
        >
          <h2 id="ncq-landing-heading" class="fc-panel-heading">
            Do you need full silence, or just less contact than you have now?
          </h2>
          <img
            class="fc-landing-illustration"
            src={landingIllustration.src}
            alt={landingIllustration.alt}
            width={landingIllustration.width}
            height={landingIllustration.height}
            loading="eager"
            decoding="async"
          />
          <p class="fc-panel-copy">
            Everyone says "go no contact." That is not always realistic. If you share
            kids, a dog, or a lease, you may need low contact instead: short, practical,
            no relationship talk.
          </p>
          <p class="fc-panel-copy fc-panel-copy--follow">
            Four honest yes-or-no questions. No account needed.
          </p>
          <button type="button" class="fc-btn fc-btn--primary" data-action="start">
            Start the quiz
          </button>
        </section>

        <section
          class="fc-panel"
          data-panel="constraint"
          aria-labelledby="ncq-constraint-heading"
          hidden
        >
          <p class="fc-progress fc-progress--eyebrow">First, your situation</p>
          <h2 id="ncq-constraint-heading" class="fc-panel-heading">
            What still ties you to your ex?
          </h2>
          <p class="fc-panel-copy fc-panel-copy--constraint">
            Pick the closest match. This only changes which questions you get, not
            whether your feelings count.
          </p>
          <div
            class="fc-constraint-list"
            role="group"
            aria-label="What still ties you to your ex?"
          >
            {
              constraints.map((item) => (
                <button
                  type="button"
                  class="fc-constraint-card"
                  data-action="constraint"
                  data-constraint={item.id}
                >
                  {item.label}
                </button>
              ))
            }
          </div>
          <p class="fc-panel-copy fc-panel-copy--helper">
            Mutual friends do not count as "having to stay in touch." If that is your
            main tie, pick <em>Nothing practical</em>.
          </p>
        </section>

        {
          questionsPathA.map((text, index) => (
            <section
              class="fc-panel"
              data-panel={`question-a-${index}`}
              data-quiz-path="a"
              aria-labelledby={`ncq-a-${index}-heading`}
              hidden
            >
              <p class="fc-progress">Question {index + 1} of {questionCount}</p>
              <h2 id={`ncq-a-${index}-heading`} class="fc-panel-heading">
                {text}
              </h2>
              <div class="fc-answers" role="group" aria-label={`Answer question ${index + 1}`}>
                <button type="button" class="fc-answer-card" data-answer="yes">
                  <PhosphorIcon name="heart-break" class="fc-answer-icon" />
                  <span class="fc-answer-label">Yes</span>
                </button>
                <button type="button" class="fc-answer-card" data-answer="no">
                  <PhosphorIcon name="shield-check" class="fc-answer-icon" />
                  <span class="fc-answer-label">No</span>
                </button>
              </div>
            </section>
          ))
        }

        {
          questionsPathB.map((text, index) => (
            <section
              class="fc-panel"
              data-panel={`question-b-${index}`}
              data-quiz-path="b"
              aria-labelledby={`ncq-b-${index}-heading`}
              hidden
            >
              <p class="fc-progress">Question {index + 1} of {questionCount}</p>
              <h2 id={`ncq-b-${index}-heading`} class="fc-panel-heading">
                {text}
              </h2>
              <div class="fc-answers" role="group" aria-label={`Answer question ${index + 1}`}>
                <button type="button" class="fc-answer-card" data-answer="yes">
                  <PhosphorIcon name="warning-circle" class="fc-answer-icon" />
                  <span class="fc-answer-label">Yes</span>
                </button>
                <button type="button" class="fc-answer-card" data-answer="no">
                  <PhosphorIcon name="check-circle" class="fc-answer-icon" />
                  <span class="fc-answer-label">No</span>
                </button>
              </div>
            </section>
          ))
        }

        <section
          class="fc-panel"
          data-panel="result-a-more"
          aria-labelledby="ncq-a-more-heading"
          hidden
        >
          <img
            class="fc-result-photo"
            src={resultImages.moreDistance.src}
            srcset={`${resultImages.moreDistance.src} ${resultImages.moreDistance.intrinsicWidth}w`}
            sizes="100vw"
            alt={resultImages.moreDistance.alt}
            width={resultImages.moreDistance.width}
            height={resultImages.moreDistance.height}
            loading="lazy"
            decoding="async"
          />
          <h2 id="ncq-a-more-heading" class="fc-panel-heading">
            You probably need more distance right now.
          </h2>
          <p class="fc-panel-copy">
            Contact, or almost-contact, is costing you. That is useful information,
            not a character flaw.
          </p>
          <p class="fc-panel-copy">
            You do not have to announce anything or make a speech. Mute their
            notifications. Stop checking their profile. Put the phone down when you want
            to "just see what they are up to."
          </p>
          <p class="fc-panel-copy">
            If you slip and text them, note what set it off and keep going. One message
            does not erase your progress.
          </p>
          <p class="fc-panel-copy">
            Distance works best when you are doing it for you, not to make them miss
            you.
          </p>
        </section>

        <section
          class="fc-panel"
          data-panel="result-a-ok"
          aria-labelledby="ncq-a-ok-heading"
          hidden
        >
          <img
            class="fc-result-photo"
            src={resultImages.ok.src}
            srcset={`${resultImages.ok.src} ${resultImages.ok.intrinsicWidth}w`}
            sizes="100vw"
            alt={resultImages.ok.alt}
            width={resultImages.ok.width}
            height={resultImages.ok.height}
            loading="lazy"
            decoding="async"
          />
          <h2 id="ncq-a-ok-heading" class="fc-panel-heading">
            Strict no contact might not be necessary yet.
          </h2>
          <p class="fc-panel-copy">
            Your answers suggest contact is not wrecking you right now. That can change.
            Check back in with yourself in a week.
          </p>
          <p class="fc-panel-copy">
            Stay honest about why you are reaching out: habit, hope, or something you
            actually need.
          </p>
          <p class="fc-panel-copy">
            Wondering about friendship instead?
            <a href="/breakup-reset/blog/en/friends-with-ex-quiz/">
              Take our friends-with-ex quiz
            </a>. Missing someone and being ready for friendship are not the same thing.
          </p>
        </section>

        <section
          class="fc-panel"
          data-panel="result-b-tighter"
          aria-labelledby="ncq-b-tighter-heading"
          hidden
        >
          <img
            class="fc-result-photo"
            src={resultImages.moreDistance.src}
            srcset={`${resultImages.moreDistance.src} ${resultImages.moreDistance.intrinsicWidth}w`}
            sizes="100vw"
            alt={resultImages.moreDistance.alt}
            width={resultImages.moreDistance.width}
            height={resultImages.moreDistance.height}
            loading="lazy"
            decoding="async"
          />
          <h2 id="ncq-b-tighter-heading" class="fc-panel-heading">
            You need tighter boundaries on the contact you cannot avoid.
          </h2>
          {
            Object.entries(constraintTips).map(([id, copy]) => (
              <p class="fc-panel-copy fc-constraint-tip" data-constraint-tip={id} hidden>
                {copy}
              </p>
            ))
          }
          <p class="fc-panel-copy">
            You do not have to go fully silent. You need less contact than you have now,
            with clearer limits on topic and timing.
          </p>
          <p class="fc-panel-copy">
            Reply when you have to. Not when you are lonely.
          </p>
        </section>

        <section
          class="fc-panel"
          data-panel="result-b-ok"
          aria-labelledby="ncq-b-ok-heading"
          hidden
        >
          <img
            class="fc-result-photo"
            src={resultImages.ok.src}
            srcset={`${resultImages.ok.src} ${resultImages.ok.intrinsicWidth}w`}
            sizes="100vw"
            alt={resultImages.ok.alt}
            width={resultImages.ok.width}
            height={resultImages.ok.height}
            loading="lazy"
            decoding="async"
          />
          <h2 id="ncq-b-ok-heading" class="fc-panel-heading">
            Your necessary contact sounds mostly under control.
          </h2>
          <p class="fc-panel-copy">
            You still have to coordinate, and you are not failing at healing because of
            that. This is the harder version of distance: functional, not romantic.
          </p>
          <p class="fc-panel-copy">
            Keep messages practical. If a thread starts drifting into the relationship,
            close it.
          </p>
          <p class="fc-panel-copy">
            If handoffs or work chats start leaving you worse for hours, come back and
            tighten up. You can adjust as you go.
          </p>
        </section>
      </div>

      <section class="fc-cta" id="fc-cta" hidden aria-labelledby="fc-cta-heading">
        <h2 id="fc-cta-heading" class="fc-cta-heading" data-cta-path="a" hidden>
          Trying to put space between you and your ex?
        </h2>
        <h2 class="fc-cta-heading" data-cta-path="b" hidden>
          Trying to keep logistics from turning into heartbreak?
        </h2>
        <p class="fc-cta-copy">
          Breakup Reset helps you track no-contact, check in with yourself, and keep a
          private journal. It is free.
        </p>
        <a
          href={downloadUrl}
          class="fc-btn fc-btn--primary fc-btn--cta"
          id="fc-download"
        >
          Download Breakup Reset for Free
        </a>
      </section>

      <div class="fc-live" aria-live="polite" aria-atomic="true" hidden></div>
    </div>

    <nav class="fc-related" aria-labelledby="ncq-related-heading">
      <h2 id="ncq-related-heading" class="fc-related-heading">More to read</h2>
      <ul class="fc-related-list">
        {
          relatedArticles.map((article) => (
            <li>
              <a class="fc-related-link" href={article.href}>
                {article.title}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="fc-related-back">
        <a href="/breakup-reset/blog/en/">Back to blog</a>
      </p>
    </nav>

    <FAQ items={faqItems} />
  </article>
</AppLayout>

<script define:vars={{ questionCount }}>
  const root = document.getElementById('no-contact-quiz');
  if (!root) throw new Error('No contact quiz root not found');

  const viewport = root.querySelector('.fc-panels-viewport');
  const panels = Array.from(root.querySelectorAll('.fc-panel'));
  const progressBar = document.getElementById('fc-progress-bar');
  const progressSteps = progressBar
    ? Array.from(progressBar.querySelectorAll('.fc-progress-step'))
    : [];
  const cta = document.getElementById('fc-cta');
  const ctaHeadings = cta ? Array.from(cta.querySelectorAll('[data-cta-path]')) : [];
  const live = root.querySelector('.fc-live');
  const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  const answers = [];
  let selectedPath = 'a';
  let selectedConstraint = 'none';
  let currentIndex = -1;
  let transitioning = false;

  function motionEnabled() {
    return !motionQuery.matches;
  }

  function motionDuration() {
    if (!motionEnabled()) return 0;
    const value = getComputedStyle(root).getPropertyValue('--fc-motion-duration').trim();
    return Number.parseInt(value, 10) || 200;
  }

  function wait(ms) {
    return new Promise((resolve) => window.setTimeout(resolve, ms));
  }

  function waitForOpacityTransition(el) {
    const duration = motionDuration();
    if (duration === 0) return Promise.resolve();

    return new Promise((resolve) => {
      let settled = false;
      const finish = () => {
        if (settled) return;
        settled = true;
        el.removeEventListener('transitionend', onEnd);
        resolve();
      };
      const onEnd = (event) => {
        if (event.target === el && event.propertyName === 'opacity') finish();
      };
      el.addEventListener('transitionend', onEnd);
      window.setTimeout(finish, duration + 80);
    });
  }

  function setPanelAccessibility(el, isHidden) {
    el.setAttribute('aria-hidden', isHidden ? 'true' : 'false');
    if (isHidden) {
      el.setAttribute('inert', '');
    } else {
      el.removeAttribute('inert');
    }
  }

  function measurePanel(el) {
    const wasHidden = el.hidden;
    el.hidden = false;
    el.style.visibility = 'hidden';
    el.style.pointerEvents = 'none';
    const height = el.offsetHeight;
    el.style.visibility = '';
    el.style.pointerEvents = '';
    if (wasHidden) el.hidden = true;
    return height;
  }

  function lockViewportHeight(nextPanel) {
    if (!(viewport instanceof HTMLElement)) return;
    const current = panels.find((el) => el.classList.contains('fc-panel--active'));
    const nextHeight = measurePanel(nextPanel);
    const currentHeight = current ? viewport.offsetHeight : 0;
    viewport.style.minHeight = `${Math.max(currentHeight, nextHeight)}px`;
  }

  function releaseViewportHeight() {
    if (!(viewport instanceof HTMLElement)) return;
    const active = panels.find((el) => el.classList.contains('fc-panel--active'));
    viewport.style.minHeight = active ? `${active.offsetHeight}px` : '';
  }

  function updateProgress(activeQuestionIndex) {
    if (!progressBar) return;

    progressSteps.forEach((step, index) => {
      step.classList.remove('fc-progress-step--done', 'fc-progress-step--current');
      if (activeQuestionIndex >= questionCount) {
        step.classList.add('fc-progress-step--done');
      } else if (index < activeQuestionIndex) {
        step.classList.add('fc-progress-step--done');
      } else if (index === activeQuestionIndex) {
        step.classList.add('fc-progress-step--current');
      }
    });

    const progressValue =
      activeQuestionIndex >= questionCount ? questionCount : activeQuestionIndex + 1;
    progressBar.setAttribute('aria-valuenow', String(progressValue));
  }

  function setCardResult(tone) {
    root.classList.remove(
      'no-contact-quiz-card--result-ok',
      'no-contact-quiz-card--result-more'
    );
    if (tone === 'ok') {
      root.classList.add('no-contact-quiz-card--result-ok');
    } else if (tone === 'more') {
      root.classList.add('no-contact-quiz-card--result-more');
    }
  }

  function panel(name) {
    return panels.find((el) => el.dataset.panel === name) ?? null;
  }

  function announce(message) {
    if (!live) return;
    live.textContent = '';
    window.setTimeout(() => {
      live.textContent = message;
    }, 30);
  }

  function showConstraintTip() {
    const resultPanel = panel('result-b-tighter');
    if (!resultPanel) return;
    resultPanel.querySelectorAll('[data-constraint-tip]').forEach((el) => {
      if (!(el instanceof HTMLElement)) return;
      const isMatch = el.dataset.constraintTip === selectedConstraint;
      el.hidden = !isMatch;
    });
  }

  function showCtaForPath(path) {
    ctaHeadings.forEach((heading) => {
      if (!(heading instanceof HTMLElement)) return;
      heading.hidden = heading.dataset.ctaPath !== path;
      if (!heading.hidden) heading.id = 'fc-cta-heading';
    });
    if (cta) cta.setAttribute('aria-labelledby', 'fc-cta-heading');
  }

  async function showPanel(name, focusSelector) {
    if (transitioning) return;
    const next = panel(name);
    const current = panels.find((el) => el.classList.contains('fc-panel--active'));
    if (!next || next === current) return;

    transitioning = true;
    root.setAttribute('aria-busy', 'true');
    lockViewportHeight(next);

    if (current) {
      setPanelAccessibility(current, true);
      current.classList.remove('fc-panel--active');
      current.classList.add('fc-panel--leaving');
      await waitForOpacityTransition(current);
      current.classList.remove('fc-panel--leaving');
      current.hidden = true;
    }

    next.hidden = false;
    next.classList.remove('fc-panel--active', 'fc-panel--leaving');
    setPanelAccessibility(next, false);
    void next.offsetHeight;
    next.classList.add('fc-panel--active');
    await waitForOpacityTransition(next);

    panels.forEach((el) => {
      if (el !== next) setPanelAccessibility(el, true);
    });
    setPanelAccessibility(next, false);

    releaseViewportHeight();
    transitioning = false;
    root.removeAttribute('aria-busy');

    const focusTarget = focusSelector
      ? next.querySelector(focusSelector)
      : next.querySelector('h2, button, a');
    if (focusTarget instanceof HTMLElement) focusTarget.focus({ preventScroll: true });
  }

  async function beginQuestions() {
    currentIndex = 0;
    answers.length = 0;
    if (progressBar) progressBar.hidden = false;
    root.classList.add('no-contact-quiz-card--in-quiz');
    updateProgress(0);
    await showPanel(`question-${selectedPath}-0`, '[data-answer="yes"]');
    announce('Question 1 of ' + questionCount);
  }

  async function finishQuiz() {
    const needsMoreDistance = answers.some((value) => value === 'yes');
    updateProgress(questionCount);

    if (selectedPath === 'a') {
      if (needsMoreDistance) {
        setCardResult('more');
        await showPanel('result-a-more');
        announce('Result: you probably need more distance right now.');
      } else {
        setCardResult('ok');
        await showPanel('result-a-ok');
        announce('Result: strict no contact might not be necessary yet.');
      }
    } else if (needsMoreDistance) {
      showConstraintTip();
      setCardResult('more');
      await showPanel('result-b-tighter');
      announce('Result: you need tighter boundaries on necessary contact.');
    } else {
      setCardResult('ok');
      await showPanel('result-b-ok');
      announce('Result: your necessary contact sounds mostly under control.');
    }

    showCtaForPath(selectedPath);
    if (cta) {
      cta.hidden = false;
      window.requestAnimationFrame(() => cta.classList.add('fc-cta--visible'));
    }
  }

  panels.forEach((el) => {
    const isActive = el.classList.contains('fc-panel--active');
    setPanelAccessibility(el, !isActive);
  });

  root.addEventListener('click', async (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;

    if (target.dataset.action === 'start') {
      await showPanel('constraint', '[data-constraint]');
      announce('Pick what still ties you to your ex.');
      return;
    }

    const constraintButton = target.closest('[data-action="constraint"]');
    if (constraintButton instanceof HTMLElement && !transitioning) {
      const constraint = constraintButton.dataset.constraint;
      if (!constraint) return;

      selectedConstraint = constraint;
      selectedPath = constraint === 'none' ? 'a' : 'b';

      constraintButton.classList.add('fc-constraint-card--chosen');
      if (motionEnabled()) await wait(120);
      constraintButton.classList.remove('fc-constraint-card--chosen');

      await beginQuestions();
      announce('Got it. Four questions next.');
      return;
    }

    const answerButton = target.closest('[data-answer]');
    if (!(answerButton instanceof HTMLElement) || transitioning) return;

    const activePanel = panels.find((el) => el.classList.contains('fc-panel--active'));
    if (!activePanel?.dataset.quizPath || activePanel.dataset.quizPath !== selectedPath) {
      return;
    }

    const answer = answerButton.dataset.answer;
    if (!answer || (answer !== 'yes' && answer !== 'no')) return;

    answerButton.classList.add('fc-answer-card--chosen');
    if (motionEnabled()) await wait(120);
    answerButton.classList.remove('fc-answer-card--chosen');

    answers.push(answer);
    currentIndex += 1;

    if (currentIndex >= questionCount) {
      await finishQuiz();
      return;
    }

    updateProgress(currentIndex);
    await showPanel(`question-${selectedPath}-${currentIndex}`, '[data-answer="yes"]');
    announce(`Question ${currentIndex + 1} of ${questionCount}`);
  });
</script>
