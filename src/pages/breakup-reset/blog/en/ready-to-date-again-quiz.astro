---
import AppLayout from '../../../../layouts/AppLayout.astro';
import Canonical from '../../../../components/seo/Canonical.astro';
import OpenGraph from '../../../../components/seo/OpenGraph.astro';
import FAQPageSchema from '../../../../components/seo/FAQPageSchema.astro';
import FAQ from '../../../../components/mdx/FAQ.astro';
import PhosphorIcon from '../../../../components/icons/PhosphorIcon.astro';
import { brands } from '../../../../config/brands';
import {
  getBreakupDownloadUrl,
  storePlacements,
} from '../../../../utils/storeLinks';

const title = 'Am I Ready to Date Again? Free Quiz';
const description =
  'No three-month rule. Four quick questions to see if you want to date someone new, or just escape missing your ex. Works if you still hope, co-parent, or already met someone.';

const brand = brands['breakup-reset'];
const pagePath = '/breakup-reset/blog/en/ready-to-date-again-quiz/';
const pageUrl = `https://athomelabs.eu${pagePath}`;

const downloadUrl = getBreakupDownloadUrl(storePlacements.quizReadyToDate);

const faqItems = [
  {
    question: 'Is there a right amount of time to wait before dating again?',
    answer:
      'No single number works for everyone. Some people need months. Some feel okay sooner. What matters more is why you want to date: curiosity about someone new, or escape from missing your ex.',
  },
  {
    question: 'Are rebound relationships always a bad idea?',
    answer:
      'Not always. For some people, dating again helps them feel like themselves and think about their ex less. For others, it is a way to avoid grief that catches up later. This quiz is about which camp you might be in right now.',
  },
  {
    question: 'Can I date if I still miss my ex?',
    answer:
      'Missing someone does not automatically mean stop. It means paying attention to whether missing them is still steering your choices: who you swipe on, what you compare, whether you are hoping to be seen.',
  },
  {
    question: 'What if I still hope we get back together?',
    answer:
      'That hope is human. Dating while holding onto it often keeps you suspended. You can want them back and still choose to pause dating until you know what you want on your own.',
  },
  {
    question: 'Can I date while co-parenting or staying in touch with my ex?',
    answer:
      'Yes. Many people do. It helps to keep logistics separate from romance, and to be upfront with new partners when the time is right. You do not need your ex fully out of your life. You do need them not to be the main story in your head.',
  },
  {
    question: 'I am already seeing someone. Should I take this quiz?',
    answer:
      'Yes. The fair question is whether you are being honest with yourself and with them about how much of your heart is still elsewhere.',
  },
  {
    question: 'What if I felt fine until I heard my ex is dating?',
    answer:
      'That can hurt even when you are doing well. One bad day does not erase progress. If it wrecks you for days and changes every decision, that is worth noticing.',
  },
  {
    question: 'I do not feel safe around my ex. Is this quiz enough?',
    answer:
      'No. If you do not feel safe, focus on support from people you trust or a professional. This quiz is for the messy middle, not danger.',
  },
];

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Am I Ready to Date Again? Free Quiz',
  url: pageUrl,
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  description:
    'A short quiz to see whether you want to date someone new or are still mainly trying not to feel your ex. Includes breakups where you still hope, co-parent, or already met someone.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  author: {
    '@type': 'Organization',
    name: brand.name,
    url: 'https://athomelabs.eu/breakup-reset/',
  },
};

const questionsShared = [
  'Are you hoping someone new will make you stop missing your ex?',
  'Do you still compare people you meet to your ex?',
  'If you found out your ex is seeing someone new, would it ruin your whole day?',
];

const question4ByConstraint: Record<string, string> = {
  hope: 'Are you dating partly to make your ex jealous, or to show you have moved on?',
  fresh:
    'Are you dating mostly because the quiet and grief feel unbearable, not because you want to meet someone?',
  contact:
    'On early dates, do you end up talking about your ex or the breakup more than you meant to?',
  new: 'If this new person asked how you still feel about your ex, would you panic or want to run?',
  steady:
    'Are you dating mostly because you hate being alone, not because you are curious about someone new?',
};

const constraints = [
  { id: 'hope', label: 'I still hope we might get back together' },
  { id: 'fresh', label: 'It ended recently and still feels raw' },
  { id: 'contact', label: 'We still have to stay in touch (kids, work, etc.)' },
  { id: 'new', label: "I'm already talking to or dating someone" },
  { id: 'steady', label: "It's been a while and I'm exploring" },
];

const slowDownTips: Record<string, string> = {
  hope: 'Dating while part of you still hopes for reunion usually keeps you in limbo. Painful, not pathetic.',
  fresh:
    'When everything is still raw, wanting to replace the feeling makes sense. It does not always mean you are ready.',
  contact:
    'You can date while you co-parent or coordinate. It is harder if you are still emotionally living in the old relationship.',
  new: 'You might owe yourself and this person an honest conversation about where your heart still is.',
  steady:
    'Your answers suggest your ex is still taking up a lot of space. More time on your own might help before you invest in someone new.',
};

const landingIllustration = {
  src: '/breakup-reset/quiz/ready-to-date-again-quiz-landing.svg',
  alt: 'Two paths: taking your time on one side, opening up to someone new on the other',
  width: 195,
  height: 185,
};

const resultImages = {
  slowDown: {
    src: '/breakup-reset/quiz/friends-with-ex-quiz-result-not-ready.png',
    alt: 'A smartphone lying face-down on a textured brown blanket, seen from above',
    width: 512,
    height: 341,
    intrinsicWidth: 1024,
  },
  ready: {
    src: '/breakup-reset/quiz/friends-with-ex-quiz-result-ready.png',
    alt: 'A wooden window swung open on a sunlit green wall',
    width: 512,
    height: 341,
    intrinsicWidth: 1024,
  },
};

const ogTitle = `${title} | ${brand.name}`;

const relatedArticles = [
  {
    href: '/breakup-reset/blog/en/am-i-ready-to-date-after-a-breakup/',
    title: 'Am I Ready to Date After a Breakup? What Research Actually Says',
  },
  {
    href: '/breakup-reset/blog/en/getting-over-a-breakup/',
    title: 'Getting over a Breakup: What the Research Actually Says',
  },
  {
    href: '/breakup-reset/blog/en/getting-over-someone-you-still-love/',
    title: 'Getting over Someone You Still Love',
  },
  {
    href: '/breakup-reset/blog/en/getting-over-long-term-relationship/',
    title: 'Getting over a Long-Term Relationship',
  },
  {
    href: '/breakup-reset/blog/en/friends-with-ex-quiz/',
    title: 'Am I Ready To Be Friends with My Ex? Free Quiz',
  },
  {
    href: '/breakup-reset/blog/en/should-i-do-no-contact-quiz/',
    title: 'Should I Do No Contact? Free Quiz',
  },
];

const questionCount = 4;
---

<AppLayout
  {title}
  {description}
  bodyClass="page ready-to-date-quiz-page"
  showSmartBanner
>
  <Canonical slot="head" />
  <OpenGraph
    slot="head"
    title={ogTitle}
    description={description}
    url={pageUrl}
    image="/breakup-reset/blog/covers/getting-over-a-breakup.jpg"
    imageWidth={1200}
    imageHeight={800}
    imageAlt="Person sitting alone on a bench looking down an oak-lined avenue"
  />
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} slot="head" />
  <FAQPageSchema items={faqItems} slot="head" />

  <article class="ready-to-date-quiz" aria-labelledby="rtd-title">
    <header class="ready-to-date-quiz-header">
      <h1 id="rtd-title" class="ready-to-date-quiz-title">
        Am I Ready to Date Again? Free Quiz
      </h1>
    </header>

    <div
      class="fc-progress-bar"
      id="fc-progress-bar"
      role="progressbar"
      aria-valuemin={0}
      aria-valuemax={questionCount}
      aria-valuenow={0}
      aria-label="Quiz progress"
      hidden
    >
      <ol class="fc-progress-steps">
        {
          Array.from({ length: questionCount }, (_, index) => (
            <li class="fc-progress-step" data-step={index}>
              <span class="fc-progress-step-marker" aria-hidden="true" />
              <span class="fc-progress-step-label">Question {index + 1}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <div
      class="ready-to-date-quiz-card"
      id="ready-to-date-quiz"
      data-download-url={downloadUrl}
    >
      <div class="fc-panels-viewport">
        <section
          class="fc-panel fc-panel--active"
          data-panel="landing"
          aria-labelledby="rtd-landing-heading"
        >
          <h2 id="rtd-landing-heading" class="fc-panel-heading">
            Ready to date again, or just tired of being alone?
          </h2>
          <img
            class="fc-landing-illustration"
            src={landingIllustration.src}
            alt={landingIllustration.alt}
            width={landingIllustration.width}
            height={landingIllustration.height}
            loading="eager"
            decoding="async"
          />
          <p class="fc-panel-copy">
            There is no perfect timeline. Some people need a long pause. Some people are
            okay sooner. What matters is whether you want to meet someone new, or stop
            feeling what you feel about your ex.
          </p>
          <p class="fc-panel-copy fc-panel-copy--follow">
            Four honest yes-or-no questions. No account needed.
          </p>
          <button type="button" class="fc-btn fc-btn--primary" data-action="start">
            Start the quiz
          </button>
        </section>

        <section
          class="fc-panel"
          data-panel="constraint"
          aria-labelledby="rtd-constraint-heading"
          hidden
        >
          <p class="fc-progress fc-progress--eyebrow">First, your situation</p>
          <h2 id="rtd-constraint-heading" class="fc-panel-heading">
            Where are you at right now?
          </h2>
          <p class="fc-panel-copy fc-panel-copy--constraint">
            Pick the closest match.
          </p>
          <div
            class="fc-constraint-list"
            role="group"
            aria-label="Where are you at right now?"
          >
            {
              constraints.map((item) => (
                <button
                  type="button"
                  class="fc-constraint-card"
                  data-action="constraint"
                  data-constraint={item.id}
                >
                  {item.label}
                </button>
              ))
            }
          </div>
          <p class="fc-panel-copy fc-panel-copy--helper">
            No perfect answer. Pick what feels true today. You can retake this next month.
          </p>
        </section>

        {
          questionsShared.map((text, index) => (
            <section
              class="fc-panel"
              data-panel={`question-${index}`}
              aria-labelledby={`rtd-q-${index}-heading`}
              hidden
            >
              <p class="fc-progress">Question {index + 1} of {questionCount}</p>
              <h2 id={`rtd-q-${index}-heading`} class="fc-panel-heading">
                {text}
              </h2>
              <div class="fc-answers" role="group" aria-label={`Answer question ${index + 1}`}>
                <button type="button" class="fc-answer-card" data-answer="yes">
                  <PhosphorIcon name="heart-break" class="fc-answer-icon" />
                  <span class="fc-answer-label">Yes</span>
                </button>
                <button type="button" class="fc-answer-card" data-answer="no">
                  <PhosphorIcon name="heart" class="fc-answer-icon" />
                  <span class="fc-answer-label">No</span>
                </button>
              </div>
            </section>
          ))
        }

        <section
          class="fc-panel"
          data-panel="question-3"
          aria-labelledby="rtd-q-3-heading"
          hidden
        >
          <p class="fc-progress">Question 4 of {questionCount}</p>
          <h2 id="rtd-q-3-heading" class="fc-panel-heading">
            {question4ByConstraint.steady}
          </h2>
          <div class="fc-answers" role="group" aria-label="Answer question 4">
            <button type="button" class="fc-answer-card" data-answer="yes">
              <PhosphorIcon name="heart-break" class="fc-answer-icon" />
              <span class="fc-answer-label">Yes</span>
            </button>
            <button type="button" class="fc-answer-card" data-answer="no">
              <PhosphorIcon name="heart" class="fc-answer-icon" />
              <span class="fc-answer-label">No</span>
            </button>
          </div>
        </section>

        <section
          class="fc-panel"
          data-panel="result-slow-down"
          aria-labelledby="rtd-slow-down-heading"
          hidden
        >
          <img
            class="fc-result-photo"
            src={resultImages.slowDown.src}
            srcset={`${resultImages.slowDown.src} ${resultImages.slowDown.intrinsicWidth}w`}
            sizes="100vw"
            alt={resultImages.slowDown.alt}
            width={resultImages.slowDown.width}
            height={resultImages.slowDown.height}
            loading="lazy"
            decoding="async"
          />
          <h2 id="rtd-slow-down-heading" class="fc-panel-heading">
            You might want to slow down for now.
          </h2>
          <p class="fc-panel-copy">
            Wanting closeness after a breakup is normal. This is not a verdict on your
            worth.
          </p>
          <p class="fc-panel-copy">
            Right now, dating might be a way to skip the hard feelings, not a way to meet
            someone. That can feel good for a while and still leave you stuck later.
          </p>
          <p class="fc-panel-copy">
            You do not have to be "over" your ex. The question is whether they are still
            the main reason you are swiping.
          </p>
          {
            Object.entries(slowDownTips).map(([id, copy]) => (
              <p class="fc-panel-copy fc-constraint-tip" data-constraint-tip={id} hidden>
                {copy}
              </p>
            ))
          }
          <p class="fc-panel-copy">
            If you can, create a little more space from your ex. Write down what you
            actually want from dating. You can retake this in a few weeks.
          </p>
        </section>

        <section
          class="fc-panel"
          data-panel="result-go-slow"
          aria-labelledby="rtd-go-slow-heading"
          hidden
        >
          <h2 id="rtd-go-slow-heading" class="fc-panel-heading">
            Mixed signals. If you date, keep it low pressure.
          </h2>
          <p class="fc-panel-copy">
            Some attachment to your ex is still there. That does not automatically mean
            stop.
          </p>
          <p class="fc-panel-copy">
            Coffee is fine. A whole relationship plot on date two is a lot. Notice if you
            feel curious about the person in front of you, not just relieved someone is
            paying attention.
          </p>
          <p class="fc-panel-copy">
            A sad wave after a good date does not mean you failed. It means you are human.
          </p>
          <p
            class="fc-panel-copy fc-constraint-tip"
            data-constraint-tip="fresh"
            data-go-slow-only
            hidden
          >
            News about your ex would probably still sting. That is expected this soon.
            Just notice if dating is helping you heal or helping you avoid.
          </p>
          <p class="fc-panel-copy">
            After each date, ask yourself: did I want company, or did I want distraction?
            There is no wrong answer. You just want to know the truth.
          </p>
        </section>

        <section
          class="fc-panel"
          data-panel="result-ready"
          aria-labelledby="rtd-ready-heading"
          hidden
        >
          <img
            class="fc-result-photo"
            src={resultImages.ready.src}
            srcset={`${resultImages.ready.src} ${resultImages.ready.intrinsicWidth}w`}
            sizes="100vw"
            alt={resultImages.ready.alt}
            width={resultImages.ready.width}
            height={resultImages.ready.height}
            loading="lazy"
            decoding="async"
          />
          <h2 id="rtd-ready-heading" class="fc-panel-heading">
            You might be in a steadier place to date.
          </h2>
          <p class="fc-panel-copy">
            This is not permission to rush, and it is not a promise dating will feel easy.
          </p>
          <p class="fc-panel-copy">
            Readiness is a direction, not a finish line. You can still have bad days, songs
            that hit wrong, or a random Tuesday that hurts.
          </p>
          <p class="fc-panel-copy">
            Stay honest if something spikes old feelings again. You do not owe anyone a
            performance of being healed.
          </p>
          <p class="fc-panel-copy">
            Date in a way that is fair to you and the other person. Curiosity is a good
            sign. Rescue is not.
          </p>
        </section>
      </div>

      <section class="fc-cta" id="fc-cta" hidden aria-labelledby="fc-cta-heading">
        <h2 id="fc-cta-heading" class="fc-cta-heading" data-cta-tier="slow-down" hidden>
          Not sure what you want from dating yet?
        </h2>
        <h2 class="fc-cta-heading" data-cta-tier="go-slow" hidden>
          Trying to date without losing yourself in the process?
        </h2>
        <h2 class="fc-cta-heading" data-cta-tier="ready" hidden>
          Want to stay honest with yourself while you date?
        </h2>
        <p class="fc-cta-copy">
          Breakup Reset helps you check in with yourself and keep a private journal. It is
          free.
        </p>
        <a
          href={downloadUrl}
          class="fc-btn fc-btn--primary fc-btn--cta"
          id="fc-download"
        >
          Download Breakup Reset for Free
        </a>
      </section>

      <div class="fc-live" aria-live="polite" aria-atomic="true" hidden></div>
    </div>

    <nav class="fc-related" aria-labelledby="rtd-related-heading">
      <h2 id="rtd-related-heading" class="fc-related-heading">More to read</h2>
      <ul class="fc-related-list">
        {
          relatedArticles.map((article) => (
            <li>
              <a class="fc-related-link" href={article.href}>
                {article.title}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="fc-related-back">
        <a href="/breakup-reset/blog/en/">Back to blog</a>
      </p>
    </nav>

    <FAQ items={faqItems} />
  </article>
</AppLayout>

<script define:vars={{ questionCount, question4ByConstraint }}>
  const root = document.getElementById('ready-to-date-quiz');
  if (!root) throw new Error('Ready to date quiz root not found');

  const viewport = root.querySelector('.fc-panels-viewport');
  const panels = Array.from(root.querySelectorAll('.fc-panel'));
  const progressBar = document.getElementById('fc-progress-bar');
  const progressSteps = progressBar
    ? Array.from(progressBar.querySelectorAll('.fc-progress-step'))
    : [];
  const cta = document.getElementById('fc-cta');
  const ctaHeadings = cta ? Array.from(cta.querySelectorAll('[data-cta-tier]')) : [];
  const question4Heading = document.getElementById('rtd-q-3-heading');
  const live = root.querySelector('.fc-live');
  const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  const answers = [];
  let selectedConstraint = 'steady';
  let currentIndex = -1;
  let transitioning = false;

  function motionEnabled() {
    return !motionQuery.matches;
  }

  function motionDuration() {
    if (!motionEnabled()) return 0;
    const value = getComputedStyle(root).getPropertyValue('--fc-motion-duration').trim();
    return Number.parseInt(value, 10) || 200;
  }

  function wait(ms) {
    return new Promise((resolve) => window.setTimeout(resolve, ms));
  }

  function waitForOpacityTransition(el) {
    const duration = motionDuration();
    if (duration === 0) return Promise.resolve();

    return new Promise((resolve) => {
      let settled = false;
      const finish = () => {
        if (settled) return;
        settled = true;
        el.removeEventListener('transitionend', onEnd);
        resolve();
      };
      const onEnd = (event) => {
        if (event.target === el && event.propertyName === 'opacity') finish();
      };
      el.addEventListener('transitionend', onEnd);
      window.setTimeout(finish, duration + 80);
    });
  }

  function setPanelAccessibility(el, isHidden) {
    el.setAttribute('aria-hidden', isHidden ? 'true' : 'false');
    if (isHidden) {
      el.setAttribute('inert', '');
    } else {
      el.removeAttribute('inert');
    }
  }

  function measurePanel(el) {
    const wasHidden = el.hidden;
    el.hidden = false;
    el.style.visibility = 'hidden';
    el.style.pointerEvents = 'none';
    const height = el.offsetHeight;
    el.style.visibility = '';
    el.style.pointerEvents = '';
    if (wasHidden) el.hidden = true;
    return height;
  }

  function lockViewportHeight(nextPanel) {
    if (!(viewport instanceof HTMLElement)) return;
    const current = panels.find((el) => el.classList.contains('fc-panel--active'));
    const nextHeight = measurePanel(nextPanel);
    const currentHeight = current ? viewport.offsetHeight : 0;
    viewport.style.minHeight = `${Math.max(currentHeight, nextHeight)}px`;
  }

  function releaseViewportHeight() {
    if (!(viewport instanceof HTMLElement)) return;
    const active = panels.find((el) => el.classList.contains('fc-panel--active'));
    viewport.style.minHeight = active ? `${active.offsetHeight}px` : '';
  }

  function updateProgress(activeQuestionIndex) {
    if (!progressBar) return;

    progressSteps.forEach((step, index) => {
      step.classList.remove('fc-progress-step--done', 'fc-progress-step--current');
      if (activeQuestionIndex >= questionCount) {
        step.classList.add('fc-progress-step--done');
      } else if (index < activeQuestionIndex) {
        step.classList.add('fc-progress-step--done');
      } else if (index === activeQuestionIndex) {
        step.classList.add('fc-progress-step--current');
      }
    });

    const progressValue =
      activeQuestionIndex >= questionCount ? questionCount : activeQuestionIndex + 1;
    progressBar.setAttribute('aria-valuenow', String(progressValue));
  }

  function setCardResult(tone) {
    root.classList.remove(
      'ready-to-date-quiz-card--result-ready',
      'ready-to-date-quiz-card--result-slow-down'
    );
    if (tone === 'ready') {
      root.classList.add('ready-to-date-quiz-card--result-ready');
    } else if (tone === 'slow-down') {
      root.classList.add('ready-to-date-quiz-card--result-slow-down');
    }
  }

  function panel(name) {
    return panels.find((el) => el.dataset.panel === name) ?? null;
  }

  function announce(message) {
    if (!live) return;
    live.textContent = '';
    window.setTimeout(() => {
      live.textContent = message;
    }, 30);
  }

  function updateQuestion4() {
    if (question4Heading && question4ByConstraint[selectedConstraint]) {
      question4Heading.textContent = question4ByConstraint[selectedConstraint];
    }
  }

  function showConstraintTips(resultPanelName) {
    const resultPanel = panel(resultPanelName);
    if (!resultPanel) return;

    resultPanel.querySelectorAll('[data-constraint-tip]').forEach((el) => {
      if (!(el instanceof HTMLElement)) return;
      const isGoSlowFresh =
        el.hasAttribute('data-go-slow-only') && resultPanelName === 'result-go-slow';
      const isSlowDownTip =
        !el.hasAttribute('data-go-slow-only') && resultPanelName === 'result-slow-down';
      const isMatch = el.dataset.constraintTip === selectedConstraint;
      el.hidden = !(isMatch && (isGoSlowFresh || isSlowDownTip));
    });
  }

  function showCtaForTier(tier) {
    ctaHeadings.forEach((heading) => {
      if (!(heading instanceof HTMLElement)) return;
      heading.hidden = heading.dataset.ctaTier !== tier;
      if (!heading.hidden) heading.id = 'fc-cta-heading';
    });
    if (cta) cta.setAttribute('aria-labelledby', 'fc-cta-heading');
  }

  async function showPanel(name, focusSelector) {
    if (transitioning) return;
    const next = panel(name);
    const current = panels.find((el) => el.classList.contains('fc-panel--active'));
    if (!next || next === current) return;

    transitioning = true;
    root.setAttribute('aria-busy', 'true');
    lockViewportHeight(next);

    if (current) {
      setPanelAccessibility(current, true);
      current.classList.remove('fc-panel--active');
      current.classList.add('fc-panel--leaving');
      await waitForOpacityTransition(current);
      current.classList.remove('fc-panel--leaving');
      current.hidden = true;
    }

    next.hidden = false;
    next.classList.remove('fc-panel--active', 'fc-panel--leaving');
    setPanelAccessibility(next, false);
    void next.offsetHeight;
    next.classList.add('fc-panel--active');
    await waitForOpacityTransition(next);

    panels.forEach((el) => {
      if (el !== next) setPanelAccessibility(el, true);
    });
    setPanelAccessibility(next, false);

    releaseViewportHeight();
    transitioning = false;
    root.removeAttribute('aria-busy');

    const focusTarget = focusSelector
      ? next.querySelector(focusSelector)
      : next.querySelector('h2, button, a');
    if (focusTarget instanceof HTMLElement) focusTarget.focus({ preventScroll: true });
  }

  async function beginQuestions() {
    currentIndex = 0;
    answers.length = 0;
    updateQuestion4();
    if (progressBar) progressBar.hidden = false;
    root.classList.add('ready-to-date-quiz-card--in-quiz');
    updateProgress(0);
    await showPanel('question-0', '[data-answer="yes"]');
    announce('Question 1 of ' + questionCount);
  }

  async function finishQuiz() {
    const yesCount = answers.filter((value) => value === 'yes').length;
    updateProgress(questionCount);

    let tier = 'ready';
    let resultPanel = 'result-ready';
    let announceMessage = 'Result: you might be in a steadier place to date.';

    if (yesCount >= 3) {
      tier = 'slow-down';
      resultPanel = 'result-slow-down';
      announceMessage = 'Result: you might want to slow down for now.';
      setCardResult('slow-down');
      showConstraintTips('result-slow-down');
    } else if (yesCount === 2) {
      tier = 'go-slow';
      resultPanel = 'result-go-slow';
      announceMessage = 'Result: mixed signals. If you date, go slow.';
      setCardResult('');
      showConstraintTips('result-go-slow');
    } else {
      setCardResult('ready');
    }

    await showPanel(resultPanel);
    announce(announceMessage);
    showCtaForTier(tier);

    if (cta) {
      cta.hidden = false;
      window.requestAnimationFrame(() => cta.classList.add('fc-cta--visible'));
    }
  }

  panels.forEach((el) => {
    const isActive = el.classList.contains('fc-panel--active');
    setPanelAccessibility(el, !isActive);
  });

  root.addEventListener('click', async (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;

    if (target.dataset.action === 'start') {
      await showPanel('constraint', '[data-constraint]');
      announce('Pick where you are at right now.');
      return;
    }

    const constraintButton = target.closest('[data-action="constraint"]');
    if (constraintButton instanceof HTMLElement && !transitioning) {
      const constraint = constraintButton.dataset.constraint;
      if (!constraint) return;

      selectedConstraint = constraint;

      constraintButton.classList.add('fc-constraint-card--chosen');
      if (motionEnabled()) await wait(120);
      constraintButton.classList.remove('fc-constraint-card--chosen');

      await beginQuestions();
      announce('Got it. Four questions next.');
      return;
    }

    const answerButton = target.closest('[data-answer]');
    if (!(answerButton instanceof HTMLElement) || transitioning) return;

    const activePanel = panels.find((el) => el.classList.contains('fc-panel--active'));
    if (!activePanel?.dataset.panel?.startsWith('question-')) return;

    const answer = answerButton.dataset.answer;
    if (!answer || (answer !== 'yes' && answer !== 'no')) return;

    answerButton.classList.add('fc-answer-card--chosen');
    if (motionEnabled()) await wait(120);
    answerButton.classList.remove('fc-answer-card--chosen');

    answers.push(answer);
    currentIndex += 1;

    if (currentIndex >= questionCount) {
      await finishQuiz();
      return;
    }

    updateProgress(currentIndex);
    await showPanel(`question-${currentIndex}`, '[data-answer="yes"]');
    announce(`Question ${currentIndex + 1} of ${questionCount}`);
  });
</script>
