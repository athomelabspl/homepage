---
import AppLayout from '../../../../layouts/AppLayout.astro';
import Canonical from '../../../../components/seo/Canonical.astro';
import OpenGraph from '../../../../components/seo/OpenGraph.astro';
import FAQPageSchema from '../../../../components/seo/FAQPageSchema.astro';
import FAQ from '../../../../components/mdx/FAQ.astro';
import PhosphorIcon from '../../../../components/icons/PhosphorIcon.astro';
import { brands } from '../../../../config/brands';
import {
  getBreakupDownloadUrl,
  storePlacements,
} from '../../../../utils/storeLinks';

const title = 'Am I Ready To Be Friends with My Ex? Free Quiz';
const description =
  'Thinking about staying friends after a breakup? Take this quick quiz to see if you are actually ready, or just missing them.';

const brand = brands['breakup-reset'];
const pagePath = '/breakup-reset/blog/en/friends-with-ex-quiz/';
const pageUrl = `https://athomelabs.eu${pagePath}`;

const downloadUrl = getBreakupDownloadUrl(storePlacements.quizFriendsWithEx);

const faqItems = [
  {
    question: 'Can I be friends with my ex?',
    answer:
      'Sometimes, but only after romantic attachment has faded. If contact still spikes your heart rate, stirs hope of getting back together, or brings up anger about the breakup, friendship will usually prolong the pain rather than help you heal.',
  },
  {
    question: 'How do I know if I am ready to be friends with my ex?',
    answer:
      'You are likely ready when you can hear about them dating someone new without a sharp emotional hit, you are not waiting for an apology, and you are not secretly hoping friendship will lead to reconciliation.',
  },
  {
    question: 'Why does staying friends after a breakup feel so hard?',
    answer:
      'Breakups do not switch off attachment overnight. Your nervous system may still treat your ex as a source of comfort and safety. Platonic contact before that bond loosens can keep you in a loop of anxiety, rumination, and false hope.',
  },
];

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Am I Ready To Be Friends with My Ex? Free Quiz',
  url: pageUrl,
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  description:
    'A four-question quiz to see whether you are ready for friendship with an ex, or still attached to the relationship.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  author: {
    '@type': 'Organization',
    name: brand.name,
    url: 'https://athomelabs.eu/breakup-reset/',
  },
};

const questions = [
  'If their name popped up on your phone screen right now, would your heart rate instantly spike or your stomach drop?',
  'Deep down, is a tiny part of you hoping that staying in their life will eventually make them realize they want you back?',
  'If they told you tomorrow that they are happily dating someone new, would it cause you physical or emotional pain?',
  'Do you still feel angry about how things ended, or find yourself secretly waiting for an apology?',
];

const forkIllustration = {
  src: '/breakup-reset/quiz/friends-with-ex-quiz-landing.svg',
  alt: 'Two overlapping heart outlines',
  width: 240,
  height: 160,
};

const resultImages = {
  notReady: {
    src: '/breakup-reset/quiz/friends-with-ex-quiz-result-not-ready.png',
    alt: 'A smartphone lying face-down on a textured brown blanket, seen from above',
    width: 512,
    height: 341,
    intrinsicWidth: 1024,
  },
  ready: {
    src: '/breakup-reset/quiz/friends-with-ex-quiz-result-ready.png',
    alt: 'A wooden window swung open on a sunlit green wall',
    width: 512,
    height: 341,
    intrinsicWidth: 1024,
  },
};

const ogTitle = `${title} | ${brand.name}`;

const relatedArticles = [
  {
    href: '/breakup-reset/blog/en/can-you-be-friends-with-your-ex/',
    title: 'Can You Be Friends with Your Ex? What Actually Determines It',
  },
  {
    href: '/breakup-reset/blog/en/anxious-attachment-after-breakup/',
    title: "Anxious Attachment after a Breakup: Why You Can't Stop Reaching for Them",
  },
  {
    href: '/breakup-reset/blog/en/no-contact-after-breakup/',
    title: "No Contact After a Breakup: What It Does (and What It Doesn't)",
  },
  {
    href: '/breakup-reset/blog/en/should-you-do-no-contact/',
    title: 'Should You Do No Contact? An Honest Guide for When You Are Not Sure',
  },
];
---

<AppLayout
  {title}
  {description}
  bodyClass="page friends-with-ex-quiz-page"
  showSmartBanner
>
  <Canonical slot="head" />
  <OpenGraph
    slot="head"
    title={ogTitle}
    description={description}
    url={pageUrl}
    image={resultImages.ready.src}
    imageWidth={resultImages.ready.intrinsicWidth}
    imageHeight={682}
    imageAlt={resultImages.ready.alt}
  />
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} slot="head" />
  <FAQPageSchema items={faqItems} slot="head" />

  <article class="friends-with-ex-quiz" aria-labelledby="feq-title">
    <header class="friends-with-ex-quiz-header">
      <h1 id="feq-title" class="friends-with-ex-quiz-title">
        Am I Ready To Be Friends with My Ex? Free Quiz
      </h1>
    </header>

    <div
      class="fc-progress-bar"
      id="fc-progress-bar"
      role="progressbar"
      aria-valuemin={0}
      aria-valuemax={questions.length}
      aria-valuenow={0}
      aria-label="Quiz progress"
      hidden
    >
      <ol class="fc-progress-steps">
        {
          questions.map((_, index) => (
            <li class="fc-progress-step" data-step={index}>
              <span class="fc-progress-step-marker" aria-hidden="true" />
              <span class="fc-progress-step-label">Question {index + 1}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <div
      class="friends-with-ex-quiz-card"
      id="friends-with-ex-quiz"
      data-download-url={downloadUrl}
    >
      <div class="fc-panels-viewport">
      <section
        class="fc-panel fc-panel--active"
        data-panel="landing"
        aria-labelledby="fc-landing-heading"
      >
        <h2 id="fc-landing-heading" class="fc-panel-heading">
          Are you actually ready to be friends, or are you just missing them?
        </h2>
        <img
          class="fc-landing-illustration"
          src={forkIllustration.src}
          alt={forkIllustration.alt}
          width={forkIllustration.width}
          height={forkIllustration.height}
          loading="eager"
          decoding="async"
        />
        <p class="fc-panel-copy">
          You can miss someone and still not be ready for friendship.
        </p>
        <p class="fc-panel-copy fc-panel-copy--follow">
          Answer these 4 questions honestly and see where you actually stand.
        </p>
        <button type="button" class="fc-btn fc-btn--primary" data-action="start">
          Start the quiz
        </button>
      </section>

      {
        questions.map((text, index) => (
          <section
            class="fc-panel"
            data-panel={`question-${index}`}
            aria-labelledby={`fc-q-${index}-heading`}
            hidden
          >
            <p class="fc-progress">
              Question {index + 1} of {questions.length}
            </p>
            <h2 id={`fc-q-${index}-heading`} class="fc-panel-heading">
              {text}
            </h2>
            <div class="fc-answers" role="group" aria-label={`Answer question ${index + 1}`}>
              <button type="button" class="fc-answer-card" data-answer="yes">
                <PhosphorIcon name="heart-break" class="fc-answer-icon" />
                <span class="fc-answer-label">Yes</span>
              </button>
              <button type="button" class="fc-answer-card" data-answer="no">
                <PhosphorIcon name="handshake" class="fc-answer-icon" />
                <span class="fc-answer-label">No</span>
              </button>
            </div>
          </section>
        ))
      }

      <section
        class="fc-panel"
        data-panel="result-not-ready"
        aria-labelledby="fc-not-ready-heading"
        hidden
      >
        <img
          class="fc-result-photo"
          src={resultImages.notReady.src}
          srcset={`${resultImages.notReady.src} ${resultImages.notReady.intrinsicWidth}w`}
          sizes="100vw"
          alt={resultImages.notReady.alt}
          width={resultImages.notReady.width}
          height={resultImages.notReady.height}
          loading="lazy"
          decoding="async"
        />
        <h2 id="fc-not-ready-heading" class="fc-panel-heading">
          You aren't ready to be friends yet.
        </h2>
        <p class="fc-panel-copy">
          You're still attached, and that's completely normal. You're not doing
          anything wrong.
        </p>
        <p class="fc-panel-copy">
          What you want right now probably isn't friendship. It's the closeness
          you used to have. Staying friends while you're still hurt usually
          keeps the wound open.
        </p>
        <p class="fc-panel-copy">
          Space isn't giving up on them. It's giving yourself room to heal.
        </p>
      </section>

      <section
        class="fc-panel"
        data-panel="result-ready"
        aria-labelledby="fc-ready-heading"
        hidden
      >
        <img
          class="fc-result-photo"
          src={resultImages.ready.src}
          srcset={`${resultImages.ready.src} ${resultImages.ready.intrinsicWidth}w`}
          sizes="100vw"
          alt={resultImages.ready.alt}
          width={resultImages.ready.width}
          height={resultImages.ready.height}
          loading="lazy"
          decoding="async"
        />
        <h2 id="fc-ready-heading" class="fc-panel-heading">
          You might actually be ready.
        </h2>
        <p class="fc-panel-copy">
          It sounds like you've moved past the romantic side of this connection.
        </p>
        <p class="fc-panel-copy">
          You're not waiting for an apology, hoping you'll get back together, or
          bracing yourself every time you think about their future.
        </p>
        <p class="fc-panel-copy">
          If you want to reach out as a friend, you're probably in a steadier
          place to do that. Just keep your boundaries clear.
        </p>
      </section>

      </div>

      <section class="fc-cta" id="fc-cta" hidden aria-labelledby="fc-cta-heading">
        <h2 id="fc-cta-heading" class="fc-cta-heading">
          Still stuck on the idea of "just being friends"?
        </h2>
        <p class="fc-cta-copy">
          Breakup Reset helps you track no-contact, check in with yourself, and
          keep a private journal. It's free.
        </p>
        <a
          href={downloadUrl}
          class="fc-btn fc-btn--primary fc-btn--cta"
          id="fc-download"
        >
          Download Breakup Reset for Free
        </a>
      </section>

      <div class="fc-live" aria-live="polite" aria-atomic="true" hidden></div>
    </div>

    <nav class="fc-related" aria-labelledby="fc-related-heading">
      <h2 id="fc-related-heading" class="fc-related-heading">More to read</h2>
      <ul class="fc-related-list">
        {
          relatedArticles.map((article) => (
            <li>
              <a class="fc-related-link" href={article.href}>
                {article.title}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="fc-related-back">
        <a href="/breakup-reset/blog/en/">Back to blog</a>
      </p>
    </nav>

    <FAQ items={faqItems} />
  </article>
</AppLayout>

<script define:vars={{ questionCount: questions.length }}>
  const root = document.getElementById('friends-with-ex-quiz');
  if (!root) throw new Error('Friends with ex quiz root not found');

  const viewport = root.querySelector('.fc-panels-viewport');
  const panels = Array.from(root.querySelectorAll('.fc-panel'));
  const progressBar = document.getElementById('fc-progress-bar');
  const progressSteps = progressBar
    ? Array.from(progressBar.querySelectorAll('.fc-progress-step'))
    : [];
  const cta = document.getElementById('fc-cta');
  const live = root.querySelector('.fc-live');
  const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  const answers = [];
  let currentIndex = -1;
  let transitioning = false;

  function motionEnabled() {
    return !motionQuery.matches;
  }

  function motionDuration() {
    if (!motionEnabled()) return 0;
    const value = getComputedStyle(root).getPropertyValue('--fc-motion-duration').trim();
    return Number.parseInt(value, 10) || 200;
  }

  function wait(ms) {
    return new Promise((resolve) => window.setTimeout(resolve, ms));
  }

  function waitForOpacityTransition(el) {
    const duration = motionDuration();
    if (duration === 0) return Promise.resolve();

    return new Promise((resolve) => {
      let settled = false;
      const finish = () => {
        if (settled) return;
        settled = true;
        el.removeEventListener('transitionend', onEnd);
        resolve();
      };
      const onEnd = (event) => {
        if (event.target === el && event.propertyName === 'opacity') finish();
      };
      el.addEventListener('transitionend', onEnd);
      window.setTimeout(finish, duration + 80);
    });
  }

  function setPanelAccessibility(el, isHidden) {
    el.setAttribute('aria-hidden', isHidden ? 'true' : 'false');
    if (isHidden) {
      el.setAttribute('inert', '');
    } else {
      el.removeAttribute('inert');
    }
  }

  function measurePanel(el) {
    const wasHidden = el.hidden;
    el.hidden = false;
    el.style.visibility = 'hidden';
    el.style.pointerEvents = 'none';
    const height = el.offsetHeight;
    el.style.visibility = '';
    el.style.pointerEvents = '';
    if (wasHidden) el.hidden = true;
    return height;
  }

  function lockViewportHeight(nextPanel) {
    if (!(viewport instanceof HTMLElement)) return;
    const current = panels.find((el) => el.classList.contains('fc-panel--active'));
    const nextHeight = measurePanel(nextPanel);
    const currentHeight = current ? viewport.offsetHeight : 0;
    viewport.style.minHeight = `${Math.max(currentHeight, nextHeight)}px`;
  }

  function releaseViewportHeight() {
    if (!(viewport instanceof HTMLElement)) return;
    const active = panels.find((el) => el.classList.contains('fc-panel--active'));
    viewport.style.minHeight = active ? `${active.offsetHeight}px` : '';
  }

  function updateProgress(activeQuestionIndex) {
    if (!progressBar) return;

    progressSteps.forEach((step, index) => {
      step.classList.remove('fc-progress-step--done', 'fc-progress-step--current');
      if (activeQuestionIndex >= questionCount) {
        step.classList.add('fc-progress-step--done');
      } else if (index < activeQuestionIndex) {
        step.classList.add('fc-progress-step--done');
      } else if (index === activeQuestionIndex) {
        step.classList.add('fc-progress-step--current');
      }
    });

    const progressValue =
      activeQuestionIndex >= questionCount ? questionCount : activeQuestionIndex + 1;
    progressBar.setAttribute('aria-valuenow', String(progressValue));
  }

  function setCardResult(result) {
    root.classList.remove(
      'friends-with-ex-quiz-card--result-ready',
      'friends-with-ex-quiz-card--result-not-ready'
    );
    if (result === 'ready') {
      root.classList.add('friends-with-ex-quiz-card--result-ready');
    } else if (result === 'not-ready') {
      root.classList.add('friends-with-ex-quiz-card--result-not-ready');
    }
  }

  function panel(name) {
    return panels.find((el) => el.dataset.panel === name) ?? null;
  }

  function announce(message) {
    if (!live) return;
    live.textContent = '';
    window.setTimeout(() => {
      live.textContent = message;
    }, 30);
  }

  async function showPanel(name, focusSelector) {
    if (transitioning) return;
    const next = panel(name);
    const current = panels.find((el) => el.classList.contains('fc-panel--active'));
    if (!next || next === current) return;

    transitioning = true;
    root.setAttribute('aria-busy', 'true');
    lockViewportHeight(next);

    if (current) {
      setPanelAccessibility(current, true);
      current.classList.remove('fc-panel--active');
      current.classList.add('fc-panel--leaving');
      await waitForOpacityTransition(current);
      current.classList.remove('fc-panel--leaving');
      current.hidden = true;
    }

    next.hidden = false;
    next.classList.remove('fc-panel--active', 'fc-panel--leaving');
    setPanelAccessibility(next, false);
    void next.offsetHeight;
    next.classList.add('fc-panel--active');
    await waitForOpacityTransition(next);

    panels.forEach((el) => {
      if (el !== next) setPanelAccessibility(el, true);
    });
    setPanelAccessibility(next, false);

    releaseViewportHeight();
    transitioning = false;
    root.removeAttribute('aria-busy');

    const focusTarget = focusSelector
      ? next.querySelector(focusSelector)
      : next.querySelector('h2, button, a');
    if (focusTarget instanceof HTMLElement) focusTarget.focus({ preventScroll: true });
  }

  async function finishQuiz() {
    const notReady = answers.some((value) => value === 'yes');
    updateProgress(questionCount);
    if (notReady) {
      setCardResult('not-ready');
      await showPanel('result-not-ready');
      announce('Result: you are not ready to be friends yet.');
    } else {
      setCardResult('ready');
      await showPanel('result-ready');
      announce('Result: you might actually be ready to be friends.');
    }
    if (cta) {
      cta.hidden = false;
      window.requestAnimationFrame(() => cta.classList.add('fc-cta--visible'));
    }
  }

  panels.forEach((el) => {
    const isActive = el.classList.contains('fc-panel--active');
    setPanelAccessibility(el, !isActive);
  });

  root.addEventListener('click', async (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;

    if (target.dataset.action === 'start') {
      currentIndex = 0;
      if (progressBar) progressBar.hidden = false;
      root.classList.add('friends-with-ex-quiz-card--in-quiz');
      updateProgress(0);
      await showPanel('question-0', '[data-answer="yes"]');
      announce('Question 1 of ' + questionCount);
      return;
    }

    const answerButton = target.closest('[data-answer]');
    if (!(answerButton instanceof HTMLElement) || transitioning) return;

    const answer = answerButton.dataset.answer;
    if (!answer || (answer !== 'yes' && answer !== 'no')) return;

    answerButton.classList.add('fc-answer-card--chosen');
    if (motionEnabled()) await wait(120);
    answerButton.classList.remove('fc-answer-card--chosen');

    answers.push(answer);
    currentIndex += 1;

    if (currentIndex >= questionCount) {
      await finishQuiz();
      return;
    }

    updateProgress(currentIndex);
    await showPanel(`question-${currentIndex}`, '[data-answer="yes"]');
    announce(`Question ${currentIndex + 1} of ${questionCount}`);
  });
</script>
