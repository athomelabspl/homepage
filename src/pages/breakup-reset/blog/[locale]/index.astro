---
import AppLayout from '../../../../layouts/AppLayout.astro';
import BlogPostCard from '../../../../components/blog/BlogPostCard.astro';
import LaunchBanner from '../../../../components/LaunchBanner.astro';
import { getCollection } from 'astro:content';
import { LOCALES, type Locale } from '../../../../config/locales';
import { FEATURED_TRANSLATION_KEY, getBlogUi } from '../../../../utils/blog';
import {
  BREAKUP_CLUSTERS,
  CLUSTER_META,
  topicHubPath,
} from '../../../../config/breakup-clusters';
import {
  getBreakupDownloadUrl,
  storePlacements,
} from '../../../../utils/storeLinks';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const ui = getBlogUi(locale);
const posts = (await getCollection('breakup-blog'))
  .filter((p) => p.data.locale === locale)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = posts.find(
  (p) => p.data.translationKey === FEATURED_TRANSLATION_KEY
);
const rest = posts.filter(
  (p) => p.data.translationKey !== FEATURED_TRANSLATION_KEY
);

const downloadUrl = getBreakupDownloadUrl(storePlacements.blogSidebarLaunch);
const topics = BREAKUP_CLUSTERS.map((cluster) => ({
  cluster,
  ...CLUSTER_META[cluster],
  href: topicHubPath(cluster, locale),
}));
---

<AppLayout
  title="Blog"
  description="Calm, practical articles on breakup recovery and emotional healing from Breakup Reset."
  lang={locale}
>
  <link
    rel="alternate"
    type="application/rss+xml"
    title={`Breakup Reset Blog (${locale})`}
    href={`/breakup-reset/blog/${locale}/rss.xml`}
    slot="head"
  />

  <div class="blog-index-layout">
    <div class="blog-index-main">
      <h1 class="page-title">Blog</h1>
      <p class="page-intro">Calm, practical guidance for your healing journey.</p>

      {
        locale === 'en' && (
          <nav class="topic-browse" aria-label={ui.browseTopics}>
            <h2 class="topic-browse-heading">{ui.browseTopics}</h2>
            <ul class="topic-browse-list">
              {topics.map((topic) => (
                <li>
                  <a href={topic.href}>{topic.title}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      {
        posts.length === 0 ? (
          <p class="muted">No articles yet. Check back soon.</p>
        ) : (
          <div class="blog-grid">
            {featured && (
              <BlogPostCard
                locale={locale}
                id={featured.id}
                title={featured.data.title}
                description={featured.data.description}
                pubDate={featured.data.pubDate}
                body={featured.body}
                cover={featured.data.cover}
                featured
              />
            )}
            {rest.map((post) => (
              <BlogPostCard
                locale={locale}
                id={post.id}
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                body={post.body}
                cover={post.data.cover}
              />
            ))}
          </div>
        )
      }
    </div>

    {
      downloadUrl ? (
        <div class="blog-index-sidebar">
          <LaunchBanner downloadUrl={downloadUrl} />
        </div>
      ) : null
    }
  </div>
</AppLayout>
