---
import AppLayout from '../../../../layouts/AppLayout.astro';
import BlogPostCard from '../../../../components/blog/BlogPostCard.astro';
import { getCollection } from 'astro:content';
import { LOCALES, type Locale } from '../../../../config/locales';
import { FEATURED_TRANSLATION_KEY } from '../../../../utils/blog';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const posts = (await getCollection('breakup-blog'))
  .filter((p) => p.data.locale === locale)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = posts.find(
  (p) => p.data.translationKey === FEATURED_TRANSLATION_KEY
);
const rest = posts.filter(
  (p) => p.data.translationKey !== FEATURED_TRANSLATION_KEY
);
---

<AppLayout
  title="Blog"
  description="Calm, practical articles on breakup recovery and emotional healing from Breakup Reset."
>
  <link
    rel="alternate"
    type="application/rss+xml"
    title={`Breakup Reset Blog (${locale})`}
    href={`/breakup-reset/blog/${locale}/rss.xml`}
    slot="head"
  />

  <h1 class="page-title">Blog</h1>
  <p class="page-intro">Calm, practical guidance for your healing journey.</p>

  {
    posts.length === 0 ? (
      <p class="muted">No articles yet. Check back soon.</p>
    ) : (
      <div class="blog-grid">
        {featured && (
          <BlogPostCard
            locale={locale}
            id={featured.id}
            title={featured.data.title}
            description={featured.data.description}
            pubDate={featured.data.pubDate}
            body={featured.body}
            cover={featured.data.cover}
            featured
          />
        )}
        {rest.map((post) => (
          <BlogPostCard
            locale={locale}
            id={post.id}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            body={post.body}
            cover={post.data.cover}
          />
        ))}
      </div>
    )
  }
</AppLayout>
