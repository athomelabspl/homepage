---
import AppLayout from '../../../../layouts/AppLayout.astro';
import Hreflang from '../../../../components/seo/Hreflang.astro';
import FAQPageSchema from '../../../../components/seo/FAQPageSchema.astro';
import BlogArticleHeader from '../../../../components/blog/BlogArticleHeader.astro';
import BlogFigure from '../../../../components/blog/BlogFigure.astro';
import RelatedPosts from '../../../../components/blog/RelatedPosts.astro';
import AISummary from '../../../../components/mdx/AISummary.astro';
import ArticlePromo from '../../../../components/mdx/ArticlePromo.astro';
import FriendsWithExQuizPromo from '../../../../components/mdx/FriendsWithExQuizPromo.astro';
import YouTubeEmbed from '../../../../components/mdx/YouTubeEmbed.astro';
import DownloadCTA from '../../../../components/mdx/DownloadCTA.astro';
import FAQ from '../../../../components/mdx/FAQ.astro';
import { getCollection, render } from 'astro:content';
import { getBlogUi, getRelatedPosts } from '../../../../utils/blog';
import type { Locale } from '../../../../config/locales';

export async function getStaticPaths() {
  const posts = await getCollection('breakup-blog');
  return posts.map((post) => {
    const parts = post.id.split('/');
    const locale = parts[0] as Locale;
    const slug = parts.slice(1).join('/') || parts[parts.length - 1];
    return {
      params: { locale, slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { locale } = Astro.params as { locale: Locale; slug: string };

const allPosts = await getCollection('breakup-blog');
const relatedPosts = getRelatedPosts(allPosts, post);

const siblings = allPosts.filter(
  (p) => p.data.translationKey === post.data.translationKey
);

const hreflangPaths = Object.fromEntries(
  siblings.map((p) => {
    const parts = p.id.split('/');
    const loc = parts[0];
    const s = parts.slice(1).join('/') || parts[parts.length - 1];
    return [loc, `/breakup-reset/blog/${loc}/${s}/`];
  })
);

const { Content } = await render(post);
const faqItems = post.data.faq ?? [];
---

<AppLayout title={post.data.title} description={post.data.description}>
  <Hreflang paths={hreflangPaths} slot="head" />
  {faqItems.length > 0 && <FAQPageSchema items={faqItems} slot="head" />}

  <article class="blog-article">
    <div class="prose blog-article-intro">
      <BlogArticleHeader
        locale={locale}
        title={post.data.title}
        description={post.data.description}
        pubDate={post.data.pubDate}
        body={post.body}
        cover={post.data.cover}
      />
    </div>
    <div class="blog-article-layout">
      <div class="blog-article-main">
        <div class="prose">
          <Content
            components={{
              AISummary,
              ArticlePromo,
              BlogFigure,
              DownloadCTA,
              FriendsWithExQuizPromo,
              YouTubeEmbed,
            }}
          />
          {faqItems.length > 0 && <FAQ items={faqItems} />}
        </div>
      </div>
      {
        relatedPosts.length > 0 && (
          <aside class="blog-article-sidebar" aria-label={getBlogUi(locale).relatedArticles}>
            <RelatedPosts locale={locale} posts={relatedPosts} />
          </aside>
        )
      }
    </div>
  </article>
</AppLayout>
