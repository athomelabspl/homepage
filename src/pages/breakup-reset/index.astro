---
import AppLayout from '../../layouts/AppLayout.astro';
import SoftwareApplicationSchema from '../../components/seo/SoftwareApplicationSchema.astro';
import FAQPageSchema from '../../components/seo/FAQPageSchema.astro';
import FAQ from '../../components/mdx/FAQ.astro';
import LaunchBanner from '../../components/LaunchBanner.astro';
import { brands } from '../../config/brands';

const brand = brands['breakup-reset'];

const features = [
  'Daily challenges for your situation',
  'Recovery that fits how you actually feel',
  'Start your journey in 2 minutes',
];

const faqItems = [
  {
    question: 'How long does it take to get over a breakup?',
    answer:
      'There is no fixed timeline. Some days feel heavier than others, and that is normal.',
  },
  {
    question: 'Is Breakup Reset a therapy app?',
    answer:
      'No. It is a self-help wellness tool, not clinical treatment or therapy.',
  },
  {
    question: 'Is Breakup Reset free?',
    answer:
      'Yes. Every feature is free. You can optionally donate to support the app.',
  },
];

const androidUrl =
  brand.stores?.android?.url ??
  `https://play.google.com/store/apps/details?id=${brand.stores?.android?.packageId}`;
const iosUrl = brand.stores?.ios?.url;
const getStartedUrl = iosUrl ?? androidUrl;
---

<AppLayout
  title="Home"
  description={brand.description ?? ''}
  bodyClass="breakup-home"
  showSmartBanner={brand.smartAppBanner}
>
  <Fragment slot="head">
    <SoftwareApplicationSchema brand={brand} />
    <FAQPageSchema items={faqItems} />
  </Fragment>

  <section class="home-hero">
    <div class="home-hero-copy">
      <h1 class="hero-headline">{brand.tagline}</h1>
      <p class="hero-subtitle">{brand.description}</p>

      <ul class="feature-list">
        {features.map((feature) => <li>{feature}</li>)}
      </ul>

      <div class="hero-actions">
        {
          getStartedUrl ? (
            <a href={getStartedUrl} class="button button-filled button-cta">
              Get started
            </a>
          ) : null
        }
        <a href="/breakup-reset/blog/en/" class="button button-secondary">Read the blog</a>
      </div>
    </div>

    {getStartedUrl ? <LaunchBanner downloadUrl={getStartedUrl} /> : null}
  </section>

  <FAQ items={faqItems} />
</AppLayout>
