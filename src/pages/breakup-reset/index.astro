---
import AppLayout from '../../layouts/AppLayout.astro';
import SoftwareApplicationSchema from '../../components/seo/SoftwareApplicationSchema.astro';
import FAQPageSchema from '../../components/seo/FAQPageSchema.astro';
import FAQ from '../../components/mdx/FAQ.astro';
import BlogPostCard from '../../components/blog/BlogPostCard.astro';
import { getCollection } from 'astro:content';
import { brands } from '../../config/brands';
import {
  getBreakupPlayStoreUrl,
  storePlacements,
} from '../../utils/storeLinks';

const brand = brands['breakup-reset'];

const faqItems = [
  {
    question: 'How long does it take to get over a breakup?',
    answer:
      'There is no fixed timeline. Some days feel heavier than others, and that is normal.',
  },
  {
    question: 'Is Breakup Reset a therapy app?',
    answer:
      'No. It is a self-help wellness tool, not clinical treatment or therapy.',
  },
  {
    question: 'Is Breakup Reset free?',
    answer:
      'Yes. Every feature is free. You can optionally donate to support the app.',
  },
];

const androidUrl = getBreakupPlayStoreUrl(storePlacements.homeHeroAndroid);

const recentPosts = (await getCollection('breakup-blog'))
  .filter((post) => post.data.locale === 'en')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const heroSlides = [
  {
    src: '/breakup-reset/marketing/iphone-1.png',
    alt: 'Breakup Reset onboarding — noticing how you feel about your ex',
  },
  {
    src: '/breakup-reset/marketing/iphone-2.png',
    alt: 'Breakup Reset app screen preview 2',
  },
  {
    src: '/breakup-reset/marketing/iphone-3.png',
    alt: 'Breakup Reset app screen preview 3',
  },
  {
    src: '/breakup-reset/marketing/iphone-4.png',
    alt: 'Breakup Reset app screen preview 4',
  },
  {
    src: '/breakup-reset/marketing/iphone-5.png',
    alt: 'Breakup Reset app screen preview 5',
  },
];

const featuredQuizzes = [
  {
    href: '/breakup-reset/blog/en/friends-with-ex-quiz/',
    title: 'Am I ready to be friends with my ex?',
    description:
      'Four yes-or-no questions. See whether you are still attached or actually ready.',
    image: {
      src: '/breakup-reset/quiz/friends-with-ex-quiz-landing.png',
      alt: 'Two overlapping heart outlines',
      width: 240,
      height: 162,
    },
  },
  {
    href: '/breakup-reset/blog/en/should-i-do-no-contact-quiz/',
    title: 'Should I do no contact?',
    description:
      'Works if you share kids, a pet, or a lease — not just clean-break situations.',
    image: {
      src: '/breakup-reset/quiz/no-contact-quiz-landing.png',
      alt: 'A barrier gate beside a winding path',
      width: 300,
      height: 248,
    },
  },
  {
    href: '/breakup-reset/blog/en/ready-to-date-again-quiz/',
    title: 'Am I ready to date again?',
    description:
      'No timeline gimmicks. Check if you want someone new, or just escape missing your ex.',
    image: {
      src: '/breakup-reset/quiz/ready-to-date-again-quiz-landing.png',
      alt: 'A single flower outline on a stem',
      width: 180,
      height: 296,
    },
  },
];
---

<AppLayout
  title="Home"
  description={brand.description ?? ''}
  bodyClass="breakup-home"
  showSmartBanner={brand.smartAppBanner}
>
  <Fragment slot="head">
    <SoftwareApplicationSchema brand={brand} />
    <FAQPageSchema items={faqItems} />
  </Fragment>

  <section class="hero-section" aria-labelledby="hero-heading">
    <h1 id="hero-heading" class="hero-section-title">
      You're in the right place.
    </h1>
    <p class="hero-section-subtitle">
      No two breakups feel the same. Get support that understands you.
    </p>

    <div class="hero-cta-group">
      <a
        href={androidUrl}
        class="button button-filled button-cta"
        rel="noopener noreferrer"
      >
        Android
      </a>
      <span class="button button-muted" aria-disabled="true">iOS (Coming Soon)</span>
    </div>

    <div
      class="hero-carousel"
      data-hero-carousel
      aria-roledescription="carousel"
      aria-label="Breakup Reset app screens"
    >
      <div class="hero-carousel-viewport">
        <ul class="hero-carousel-track">
          {
            heroSlides.map((slide, index) => (
              <li
                class:list={['hero-carousel-slide', { 'is-active': index === 0 }]}
                data-slide
                aria-hidden={index === 0 ? 'false' : 'true'}
              >
                <img
                  src={slide.src}
                  alt={slide.alt}
                  width="320"
                  height="640"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </li>
            ))
          }
        </ul>
      </div>

      <div class="hero-carousel-controls">
        <button
          type="button"
          class="hero-carousel-btn"
          data-carousel-prev
          aria-label="Previous screen"
        >
          ‹
        </button>
        <div class="hero-carousel-dots" role="tablist" aria-label="Choose screen">
          {
            heroSlides.map((_, index) => (
              <button
                type="button"
                class:list={['hero-carousel-dot', { 'is-active': index === 0 }]}
                role="tab"
                data-carousel-dot
                aria-label={`Show screen ${index + 1}`}
                aria-selected={index === 0 ? 'true' : 'false'}
              />
            ))
          }
        </div>
        <button
          type="button"
          class="hero-carousel-btn"
          data-carousel-next
          aria-label="Next screen"
        >
          ›
        </button>
      </div>
    </div>
  </section>

  <script>
    function initHeroCarousel(root: HTMLElement) {
      const slides = Array.from(
        root.querySelectorAll<HTMLElement>('[data-slide]')
      );
      const dots = Array.from(
        root.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]')
      );
      const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
      const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
      if (slides.length === 0) return;

      let index = 0;
      let timer: ReturnType<typeof setInterval> | undefined;

      const show = (nextIndex: number) => {
        index = (nextIndex + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          const active = i === index;
          slide.classList.toggle('is-active', active);
          slide.setAttribute('aria-hidden', active ? 'false' : 'true');
        });
        dots.forEach((dot, i) => {
          const active = i === index;
          dot.classList.toggle('is-active', active);
          dot.setAttribute('aria-selected', active ? 'true' : 'false');
        });
      };

      const stop = () => {
        if (timer) clearInterval(timer);
        timer = undefined;
      };

      const start = () => {
        stop();
        timer = setInterval(() => show(index + 1), 4500);
      };

      prev?.addEventListener('click', () => {
        show(index - 1);
        start();
      });
      next?.addEventListener('click', () => {
        show(index + 1);
        start();
      });
      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          show(i);
          start();
        });
      });

      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', start);

      show(0);
      start();
    }

    document
      .querySelectorAll<HTMLElement>('[data-hero-carousel]')
      .forEach(initHeroCarousel);
  </script>

  <aside class="stats-banner" aria-label="App highlights">
    <div class="stats-banner-item">
      <span class="stats-banner-value">3</span>
      <span class="stats-banner-label">Challenges a Day</span>
    </div>
    <div class="stats-banner-item">
      <span class="stats-banner-value">4</span>
      <span class="stats-banner-label">Recovery Paths</span>
    </div>
    <div class="stats-banner-item">
      <span class="stats-banner-value">100%</span>
      <span class="stats-banner-label">On Your Pace</span>
    </div>
  </aside>

  <section class="quiz-preview-section" aria-labelledby="quiz-preview-heading">
    <h2 id="quiz-preview-heading" class="section-title">Free Quizzes</h2>
    <p class="quiz-preview-intro">
      When you’re unsure what to do next, answer a few questions first.
    </p>
    <div class="quiz-preview-grid">
      {
        featuredQuizzes.map((quiz) => (
          <article class="quiz-preview-card">
            <img
              class="quiz-preview-icon"
              src={quiz.image.src}
              alt=""
              width={quiz.image.width}
              height={quiz.image.height}
              loading="lazy"
              decoding="async"
            />
            <p class="quiz-preview-eyebrow">Free quiz</p>
            <h3 class="quiz-preview-title">
              <a href={quiz.href}>{quiz.title}</a>
            </h3>
            <p class="quiz-preview-description">{quiz.description}</p>
            <a class="quiz-preview-link" href={quiz.href}>
              Take the quiz →
            </a>
          </article>
        ))
      }
    </div>
  </section>

  {
    recentPosts.length > 0 && (
      <section class="blog-preview-section" aria-labelledby="blog-preview-heading">
        <h2 id="blog-preview-heading" class="section-title">
          Articles &amp; Insights
        </h2>
        <div class="blog-preview-grid">
          {recentPosts.map((post) => (
            <BlogPostCard
              locale="en"
              id={post.id}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              body={post.body}
              cover={post.data.cover}
            />
          ))}
        </div>
      </section>
    )
  }

  <FAQ items={faqItems} class="faq-section--home" />
</AppLayout>
