---
import '../styles/global.css';
import Canonical from '../components/seo/Canonical.astro';
import Analytics from '../components/Analytics.astro';
import MarketingPixels from '../components/MarketingPixels.astro';
import type { BrandConfig } from '../config/brands';

interface Props {
  title: string;
  description: string;
  brand: BrandConfig;
  bodyClass?: string;
  disableAnalytics?: boolean;
  smartAppBanner?: boolean;
  lang?: string;
}

const {
  title,
  description,
  brand,
  bodyClass,
  disableAnalytics = false,
  smartAppBanner = false,
  lang = 'en',
} = Astro.props;

const fullTitle =
  brand.id === 'studio' ? title : `${title} | ${brand.name}`;

const iosAppId = brand.stores?.ios?.appId;
const deepLink = brand.stores?.deepLinkScheme;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="p:domain_verify" content="27c471e43d38fdb3c9e0961e1b8ec191" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {
      brand.id === 'breakup-reset' ? (
        <link
          href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700;800;900&display=swap"
          rel="stylesheet"
        />
      ) : (
        <link
          href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Inter:wght@400;500;600&display=swap"
          rel="stylesheet"
        />
      )
    }
    <Canonical />
    {
      smartAppBanner && iosAppId && (
        <meta
          name="apple-itunes-app"
          content={`app-id=${iosAppId}${deepLink ? `, app-argument=${deepLink}` : ''}`}
        />
      )
    }
    <slot name="head" />
    <Analytics brand={brand} disabled={disableAnalytics} />
    <MarketingPixels brand={brand} disabled={disableAnalytics} />
  </head>
  <body data-brand={brand.id} class={bodyClass}>
    <slot />

    {brand.id === 'breakup-reset' && (
      <script>
        (() => {
          try {
            const body = document.body;
            if (!body || body.dataset.brand !== 'breakup-reset') return;

            const params = new URLSearchParams(window.location.search);
            const utm_source = params.get('utm_source');
            const utm_medium = params.get('utm_medium');
            const utm_campaign = params.get('utm_campaign');
            if (!utm_source || !utm_medium || !utm_campaign) return;

            // Match the exact format Play expects inside the referrer payload.
            const referrerPayload = `utm_source=${utm_source}&utm_medium=${utm_medium}&utm_campaign=${utm_campaign}`;

            document
              .querySelectorAll(
                'a[href*="play.google.com/store/apps/details"]'
              )
              .forEach((a) => {
                try {
                  const href = a.getAttribute('href');
                  if (!href) return;

                  const u = new URL(href, window.location.origin);
                  if (u.searchParams.get('id') !== 'com.breakupreset')
                    return;

                  u.searchParams.set('referrer', referrerPayload);
                  a.setAttribute('href', u.toString());
                } catch {
                  // Ignore malformed URLs.
                }
              });
          } catch {
            // No-op.
          }
        })();
      </script>
    )}
  </body>
</html>
