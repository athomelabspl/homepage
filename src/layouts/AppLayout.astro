---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { brands, type BrandNavItem } from '../config/brands';

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  disableAnalytics?: boolean;
  showSmartBanner?: boolean;
  lang?: string;
  nav?: BrandNavItem[];
  homeHref?: string;
  downloadLabel?: string;
}

const {
  title,
  description,
  bodyClass = 'page',
  disableAnalytics = false,
  showSmartBanner = false,
  lang = 'en',
  nav,
  homeHref,
  downloadLabel,
} = Astro.props;

const brand = brands['breakup-reset'];
---

<BaseLayout
  title={title}
  description={description}
  brand={brand}
  bodyClass={bodyClass}
  disableAnalytics={disableAnalytics}
  smartAppBanner={showSmartBanner && brand.smartAppBanner}
  lang={lang}
>
  <slot name="head" slot="head" />
  <div class="layout">
    <div class="site-chrome">
      <SiteHeader
        brand={brand}
        homeHref={homeHref ?? brand.basePath}
        nav={nav}
        downloadLabel={downloadLabel}
      />
    </div>
    <div class="site-body">
      <main>
        <slot />
      </main>
      <SiteFooter brand={brand} showStudioLink />
    </div>
  </div>
</BaseLayout>
