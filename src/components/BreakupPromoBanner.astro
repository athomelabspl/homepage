---
import { brands } from '../config/brands';
import { breakupPromo, getPromoCopy } from '../config/breakup-promo';
import type { Locale } from '../config/locales';
import {
  storePlacements,
  withStoreTracking,
} from '../utils/storeLinks';

interface Props {
  locale: Locale;
  source?: string;
  variant?: 'full' | 'compact';
}

const { locale, source = storePlacements.blogPromo, variant = 'full' } =
  Astro.props;
const isCompact = variant === 'compact';
const copy = getPromoCopy(locale);
const brand = brands['breakup-reset'];
const { mode, waitlistUrl, image } = breakupPromo;

const androidUrl = withStoreTracking(
  brand.stores?.android?.url ??
    `https://play.google.com/store/apps/details?id=${brand.stores?.android?.packageId}`,
  source
);
const iosUrl = brand.stores?.ios?.url
  ? withStoreTracking(brand.stores.ios.url, source)
  : undefined;
const trackedWaitlistUrl = waitlistUrl
  ? withStoreTracking(waitlistUrl, source)
  : undefined;
---

<section
  class:list={['breakup-promo', { 'breakup-promo--compact': isCompact }]}
  lang={locale}
  aria-labelledby="breakup-promo-heading"
  data-promo-mode={mode}
>
  {
    isCompact ? (
      <div class="breakup-promo-compact-copy">
        <h2 id="breakup-promo-heading" class="breakup-promo-title">
          {copy.title}
        </h2>
        {copy.subtitle && (
          <p class="breakup-promo-subtitle">{copy.subtitle}</p>
        )}
      </div>
    ) : (
      <div class="breakup-promo-inner">
        <div class="breakup-promo-copy">
          <p class="breakup-promo-eyebrow">{brand.name}</p>
          <h2 id="breakup-promo-heading" class="breakup-promo-title">
            {copy.title}
          </h2>
          {copy.subtitle && (
            <p class="breakup-promo-subtitle">{copy.subtitle}</p>
          )}
          <ul class="breakup-promo-features">
            {copy.features.map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>
          <div class="breakup-promo-action">
            {
              mode === 'coming-soon' && (
                <p class="breakup-promo-badge" aria-live="polite">
                  {copy.comingSoonLabel}
                </p>
              )
            }
            {
              mode === 'waitlist' && trackedWaitlistUrl && (
                <a
                  href={trackedWaitlistUrl}
                  class="button button-filled button-cta"
                >
                  {copy.waitlistCtaLabel}
                </a>
              )
            }
            {
              mode === 'live' && (
                <div class="breakup-promo-buttons">
                  {iosUrl && (
                    <a
                      href={iosUrl}
                      class="button button-filled button-cta"
                    >
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
                      {copy.liveCtaLabel}
                    </a>
                  )}
                  {androidUrl && (
                    <a
                      href={androidUrl}
                      class="button button-filled button-cta"
                    >
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M6 18c0 .55.45 1 1 1h1v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h2v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h1c.55 0 1-.45 1-1V7H6v11zM3.5 7C2.67 7 2 7.67 2 8.5v7c0 .83.67 1.5 1.5 1.5S5 16.33 5 15.5v-7C5 7.67 4.33 7 3.5 7zm17 0c-.83 0-1.5.67-1.5 1.5v7c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5v-7c0-.83-.67-1.5-1.5-1.5zm-4.97-5.84l1.3-1.3c.2-.2.2-.51 0-.71-.2-.2-.51-.2-.71 0l-1.48 1.48A5.84 5.84 0 0 0 12 1c-.96 0-1.86.23-2.66.63L7.85.15c-.2-.2-.51-.2-.71 0-.2.2-.2.51 0 .71l1.31 1.31A5.983 5.983 0 0 0 6 7h12c0-2.21-1.2-4.15-2.97-5.16l-.03-.02zM10 5H9V4h1v1zm5 0h-1V4h1v1z"/></svg>
                      {copy.liveCtaLabel}
                    </a>
                  )}
                  {!iosUrl && !androidUrl && (
                    <p class="breakup-promo-badge" aria-live="polite">
                      {copy.comingSoonLabel}
                    </p>
                  )}
                </div>
              )
            }
          </div>
        </div>

        <div class="breakup-promo-visual">
          <figure class="breakup-promo-figure">
            <img
              class="breakup-promo-graphic"
              src={image}
              alt={copy.imageAlt}
              width="250"
              height="507"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>
      </div>
    )
  }

  {
    isCompact && (
      <div class="breakup-promo-action">
        {
          mode === 'coming-soon' && (
            <p class="breakup-promo-badge" aria-live="polite">
              {copy.comingSoonLabel}
            </p>
          )
        }
        {
          mode === 'waitlist' && trackedWaitlistUrl && (
            <a
              href={trackedWaitlistUrl}
              class="button button-filled button-cta"
            >
              {copy.waitlistCtaLabel}
            </a>
          )
        }
        {
          mode === 'live' && (
            <div class="breakup-promo-buttons">
              {iosUrl && (
                <a
                  href={iosUrl}
                  class="button button-filled button-cta"
                >
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
                  {copy.liveCtaLabel}
                </a>
              )}
              {androidUrl && (
                <a
                  href={androidUrl}
                  class="button button-filled button-cta"
                >
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M6 18c0 .55.45 1 1 1h1v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h2v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h1c.55 0 1-.45 1-1V7H6v11zM3.5 7C2.67 7 2 7.67 2 8.5v7c0 .83.67 1.5 1.5 1.5S5 16.33 5 15.5v-7C5 7.67 4.33 7 3.5 7zm17 0c-.83 0-1.5.67-1.5 1.5v7c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5v-7c0-.83-.67-1.5-1.5-1.5zm-4.97-5.84l1.3-1.3c.2-.2.2-.51 0-.71-.2-.2-.51-.2-.71 0l-1.48 1.48A5.84 5.84 0 0 0 12 1c-.96 0-1.86.23-2.66.63L7.85.15c-.2-.2-.51-.2-.71 0-.2.2-.2.51 0 .71l1.31 1.31A5.983 5.983 0 0 0 6 7h12c0-2.21-1.2-4.15-2.97-5.16l-.03-.02zM10 5H9V4h1v1zm5 0h-1V4h1v1z"/></svg>
                  {copy.liveCtaLabel}
                </a>
              )}
              {!iosUrl && !androidUrl && (
                <p class="breakup-promo-badge" aria-live="polite">
                  {copy.comingSoonLabel}
                </p>
              )}
            </div>
          )
        }
      </div>
    )
  }
</section>
