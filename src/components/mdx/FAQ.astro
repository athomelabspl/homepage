---
interface FAQItem {
  question: string;
  answer: string;
  elaboration?: string;
}

interface Props {
  items?: FAQItem[];
  class?: string;
  heading?: string;
}

const {
  items = [],
  class: className,
  heading = 'Frequently Asked Questions',
} = Astro.props;
---

{
  items.length > 0 && (
    <section class:list={['faq-section', className]} aria-label={heading}>
      <h2 class="section-title">{heading}</h2>
      {items.map((item) => (
        <details class="faq-item">
          <summary class="faq-question">{item.question}</summary>
          <div class="faq-answer">
            <p>{item.answer}</p>
            {item.elaboration && <p class="faq-elaboration">{item.elaboration}</p>}
          </div>
        </details>
      ))}
    </section>
  )
}
