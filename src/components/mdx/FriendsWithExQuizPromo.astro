---
const quizUrl = '/breakup-reset/blog/en/friends-with-ex-quiz/';
---

<aside class="quiz-promo feature-callout" aria-labelledby="friends-with-ex-quiz-promo-heading">
  <p class="feature-callout-label">Free quiz</p>
  <h3 id="friends-with-ex-quiz-promo-heading">Am I ready to be friends with my ex?</h3>
  <p>
    Four yes-or-no questions. No account needed. See whether you are still attached
    or actually ready.
  </p>
  <p class="quiz-promo-action">
    <a href={quizUrl} class="button button-filled button-cta">Take the quiz</a>
  </p>
</aside>
