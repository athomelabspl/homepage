---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const site = Astro.site?.href.replace(/\/$/, '') ?? 'https://athomelabs.eu';
const embedUrl = `https://www.youtube.com/embed/${id}?rel=0&modestbranding=1&origin=${encodeURIComponent(site)}`;
const watchUrl = `https://www.youtube.com/watch?v=${id}`;
---

<figure class="youtube-embed">
  <div class="youtube-embed-frame">
    <iframe
      src={embedUrl}
      title={title}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>
  </div>
  <figcaption class="youtube-embed-caption">
    <a href={watchUrl} target="_blank" rel="noopener noreferrer">
      Watch on YouTube
    </a>
  </figcaption>
</figure>
