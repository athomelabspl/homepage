---
interface Props {
  downloadUrl: string;
}

const { downloadUrl } = Astro.props;
---

<aside class="launch-banner" aria-label="Breakup Reset free app">
  <div class="launch-banner-bamboo" aria-hidden="true">
    <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path
        d="m108.4 30.28c-0.15 8.68-3.29 24.53-10.35 39.93-0.82 1.9-0.28 3.5 1.62 3.85l10.18 2.2c1.97 0.45 3.15-0.88 3.15-2.85 0.42-10.8 3.71-26.05 9.87-38.99 0.9-1.9-0.07-3.73-2.19-4-2.93-0.35-6-1.25-8.51-2-1.97-0.61-3.74-0.11-3.77 1.86z"
        fill="#1F5535"></path>
      <path
        d="m97.05 78.16c-0.35 9.65-3.64 26.56-9.34 42.77-0.75 2.19-0.21 4.23 1.98 4.58l9.03 1.69c2.04 0.42 3.01-0.99 3.01-3.1 0.48-11.48 3.78-28.74 9.34-41.89 0.96-2.33-0.14-3.51-2.11-3.86l-8.9-1.9c-1.62-0.42-2.94 0.08-3.01 1.71z"
        fill="#1F5535"></path>
      <path
        d="m86.29 129.7c-0.35 8.14-2.54 22.17-7.41 36.34-0.75 2.19-0.28 3.75 1.91 4.1l9.1 1.73c2.05 0.42 3.17-0.92 2.96-2.96-0.68-8.47 2.61-24.82 7.21-35.7 0.89-2.19-0.07-3.58-1.69-3.79l-9.42-1.89c-1.69-0.28-2.73 0.36-2.66 2.17z"
        fill="#1F5535"></path>
      <path
        d="m94.94 68.72c0-11.89-7.71-24.48-19.6-34.38 0.89 11.97 7.59 24.01 19.6 34.38z"
        fill="#1F5535"></path>
      <path
        d="m65.61 57.46c7.2 0.07 17.6 2.46 29.05 13.84-10.73 0.42-21.03-3.97-29.05-13.84z"
        fill="#1F5535"></path>
      <path
        d="m104.8 121.8c2.26-11.68 11.95-22.92 27.06-30.26-3.97 11.82-12.9 22.62-27.06 31.17"
        fill="#1F5535"></path>
      <path
        d="m104.9 124.4c9.1 1.26 19.9-1.07 31.07-8.2-9.28-2.33-20.22-0.43-31.07 8.2z"
        fill="#1F5535"></path>
    </svg>
  </div>

  <p class="launch-banner-badge">It's here</p>

  <h2 class="launch-banner-headline">
    Your reset starts <span>today.</span>
  </h2>

  <p class="launch-banner-sub">
    Dealing with a tough breakup? Get through it at your own pace with our free
    daily challenges and structured support.
  </p>

  <a class="launch-banner-cta button button-filled button-cta" href={downloadUrl}>
    Get the Free App
  </a>

  <div class="launch-banner-stats">
    <div class="launch-banner-stat">
      <span class="launch-banner-stat-num">3</span>
      <span class="launch-banner-stat-lbl">Challenges a day</span>
    </div>
    <div class="launch-banner-stat">
      <span class="launch-banner-stat-num">4</span>
      <span class="launch-banner-stat-lbl">Recovery paths</span>
    </div>
    <div class="launch-banner-stat">
      <span class="launch-banner-stat-num">100%</span>
      <span class="launch-banner-stat-lbl">On your pace</span>
    </div>
  </div>
</aside>
