---
import type { BrandConfig } from '../config/brands';
import {
  getBreakupPlayStoreUrl,
  storePlacements,
} from '../utils/storeLinks';

interface Props {
  brand: BrandConfig;
  homeHref: string;
}

const { brand, homeHref } = Astro.props;
const currentPath = Astro.url.pathname;
const isBreakupReset = brand.id === 'breakup-reset';
const androidUrl = isBreakupReset
  ? getBreakupPlayStoreUrl(storePlacements.homeHeaderDownload)
  : undefined;
---

<header class="site-header">
  <a class="brand" href={homeHref}>
    {
      brand.logo && (
        <img
          class="brand-logo"
          src={brand.logo}
          alt=""
          width="36"
          height="36"
          decoding="async"
        />
      )
    }
    <span class="brand-name">{brand.name}</span>
  </a>
  <div class="site-header-end">
    <nav class="site-nav" aria-label="Main">
      {
        brand.nav.map((item) => (
          <a
            href={item.href}
            aria-current={currentPath === item.href ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    {
      isBreakupReset && androidUrl && (
        <a
          href={androidUrl}
          class="button button-filled site-header-cta"
          rel="noopener noreferrer"
        >
          Download
        </a>
      )
    }
  </div>
</header>
