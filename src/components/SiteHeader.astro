---
import type { BrandConfig, BrandNavItem } from '../config/brands';
import {
  getBreakupDownloadUrl,
  getBreakupPlayStoreUrl,
  storePlacements,
} from '../utils/storeLinks';

interface Props {
  brand: BrandConfig;
  homeHref: string;
  nav?: BrandNavItem[];
  downloadLabel?: string;
}

const { brand, homeHref, nav, downloadLabel = 'Download' } = Astro.props;
const navItems = nav ?? brand.nav;
const currentPath = Astro.url.pathname;
const isBreakupReset = brand.id === 'breakup-reset';
const androidUrl = isBreakupReset
  ? getBreakupPlayStoreUrl(storePlacements.homeHeaderDownload)
  : undefined;
const iosUrl = isBreakupReset
  ? getBreakupDownloadUrl(storePlacements.homeHeaderIos)
  : undefined;
---

<header class="site-header">
  <a class="brand" href={homeHref}>
    {
      brand.logo && (
        <img
          class="brand-logo"
          src={brand.logo}
          alt=""
          width="36"
          height="36"
          decoding="async"
        />
      )
    }
    <span class="brand-name">{brand.name}</span>
  </a>
  <div class="site-header-end">
    <nav class="site-nav" aria-label="Main">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={currentPath === item.href ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    {
      isBreakupReset && (
        <div class="header-cta-group">
          {iosUrl && (
            <a
              href={iosUrl}
              class="button button-filled site-header-cta"
              rel="noopener noreferrer"
            >
              iOS
            </a>
          )}
          {androidUrl && (
            <a
              href={androidUrl}
              class="button button-filled site-header-cta"
              rel="noopener noreferrer"
            >
              Android
            </a>
          )}
        </div>
      )
    }
  </div>
</header>
