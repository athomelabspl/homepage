---
import AppLayout from '../layouts/AppLayout.astro';
import SoftwareApplicationSchema from './seo/SoftwareApplicationSchema.astro';
import FAQPageSchema from './seo/FAQPageSchema.astro';
import OpenGraph from './seo/OpenGraph.astro';
import Hreflang from './seo/Hreflang.astro';
import FAQ from './mdx/FAQ.astro';
import BlogPostCard from './blog/BlogPostCard.astro';
import { getCollection } from 'astro:content';
import { brands } from '../config/brands';
import {
  getBreakupChrome,
  marketingLandingHreflangPaths,
  type LandingLocale,
} from '../config/breakup-chrome';
import { getBreakupLandingCopy } from '../config/breakup-landing';
import {
  getBreakupPlayStoreUrl,
  storePlacements,
} from '../utils/storeLinks';

interface Props {
  locale: LandingLocale;
}

const { locale } = Astro.props;
const copy = getBreakupLandingCopy(locale);
const chrome = getBreakupChrome(locale);
const brand = brands['breakup-reset'];
const androidUrl = getBreakupPlayStoreUrl(storePlacements.homeHeroAndroid);

const recentPosts = copy.showArticles
  ? (await getCollection('breakup-blog'))
      .filter((post) => post.data.locale === 'en')
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
      .slice(0, 3)
  : [];

const hreflangPaths = marketingLandingHreflangPaths();

const site = 'https://athomelabs.eu';
const pageUrl = `${site}${hreflangPaths[locale]}`;
const ogTitle = `${copy.title} | ${brand.name}`;
---

<AppLayout
  title={copy.title}
  description={copy.description}
  bodyClass="breakup-home"
  showSmartBanner={brand.smartAppBanner}
  lang={chrome.lang}
  nav={chrome.nav}
  homeHref={chrome.homeHref}
  downloadLabel={chrome.downloadLabel}
>
  <Fragment slot="head">
    <Hreflang paths={hreflangPaths} />
    <OpenGraph
      title={ogTitle}
      description={copy.description}
      url={pageUrl}
      locale={chrome.ogLocale}
      localeAlternates={chrome.ogLocaleAlternates}
    />
    <SoftwareApplicationSchema brand={brand} />
    <FAQPageSchema items={copy.faqItems} />
  </Fragment>

  <section class="hero-section" aria-labelledby="hero-heading">
    <h1 id="hero-heading" class="hero-section-title">
      {copy.heroHeading}
    </h1>
    <p class="hero-section-subtitle">
      {copy.heroSubtitle}
    </p>

    <div class="hero-cta-group">
      <a
        href={androidUrl}
        class="button button-filled button-cta"
        rel="noopener noreferrer"
      >
        {copy.androidCta}
      </a>
      <span class="button button-muted" aria-disabled="true"
        >{copy.iosComingSoon}</span
      >
    </div>

    <div
      class="hero-carousel"
      data-hero-carousel
      aria-roledescription="carousel"
      aria-label={copy.carouselLabel}
    >
      <div class="hero-carousel-viewport">
        <ul class="hero-carousel-track">
          {
            copy.heroSlides.map((slide, index) => (
              <li
                class:list={[
                  'hero-carousel-slide',
                  { 'is-active': index === 0 },
                ]}
                data-slide
                aria-hidden={index === 0 ? 'false' : 'true'}
              >
                <img
                  src={slide.src}
                  alt={slide.alt}
                  width="320"
                  height="640"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </li>
            ))
          }
        </ul>
      </div>

      <div class="hero-carousel-controls">
        <button
          type="button"
          class="hero-carousel-btn"
          data-carousel-prev
          aria-label={copy.prevScreen}
        >
          ‹
        </button>
        <div
          class="hero-carousel-dots"
          role="tablist"
          aria-label={copy.chooseScreen}
        >
          {
            copy.heroSlides.map((_, index) => (
              <button
                type="button"
                class:list={[
                  'hero-carousel-dot',
                  { 'is-active': index === 0 },
                ]}
                role="tab"
                data-carousel-dot
                aria-label={copy.showScreen(index + 1)}
                aria-selected={index === 0 ? 'true' : 'false'}
              />
            ))
          }
        </div>
        <button
          type="button"
          class="hero-carousel-btn"
          data-carousel-next
          aria-label={copy.nextScreen}
        >
          ›
        </button>
      </div>
    </div>
  </section>

  <script>
    function initHeroCarousel(root: HTMLElement) {
      const slides = Array.from(
        root.querySelectorAll<HTMLElement>('[data-slide]')
      );
      const dots = Array.from(
        root.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]')
      );
      const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
      const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
      if (slides.length === 0) return;

      let index = 0;
      let timer: ReturnType<typeof setInterval> | undefined;

      const show = (nextIndex: number) => {
        index = (nextIndex + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          const active = i === index;
          slide.classList.toggle('is-active', active);
          slide.setAttribute('aria-hidden', active ? 'false' : 'true');
        });
        dots.forEach((dot, i) => {
          const active = i === index;
          dot.classList.toggle('is-active', active);
          dot.setAttribute('aria-selected', active ? 'true' : 'false');
        });
      };

      const stop = () => {
        if (timer) clearInterval(timer);
        timer = undefined;
      };

      const start = () => {
        stop();
        timer = setInterval(() => show(index + 1), 4500);
      };

      prev?.addEventListener('click', () => {
        show(index - 1);
        start();
      });
      next?.addEventListener('click', () => {
        show(index + 1);
        start();
      });
      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          show(i);
          start();
        });
      });

      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', start);

      show(0);
      start();
    }

    document
      .querySelectorAll<HTMLElement>('[data-hero-carousel]')
      .forEach(initHeroCarousel);
  </script>

  <aside class="stats-banner" aria-label={copy.statsLabel}>
    {
      copy.stats.map((stat) => (
        <div class="stats-banner-item">
          <span class="stats-banner-value">{stat.value}</span>
          <span class="stats-banner-label">{stat.label}</span>
        </div>
      ))
    }
  </aside>

  <section class="quiz-preview-section" aria-labelledby="quiz-preview-heading">
    <h2 id="quiz-preview-heading" class="section-title">
      {copy.quizzesHeading}
    </h2>
    <p class="quiz-preview-intro">{copy.quizzesIntro}</p>
    <div class="quiz-preview-grid">
      {
        copy.featuredQuizzes.map((quiz) => (
          <article class="quiz-preview-card">
            <img
              class="quiz-preview-icon"
              src={quiz.image.src}
              alt=""
              width={quiz.image.width}
              height={quiz.image.height}
              loading="lazy"
              decoding="async"
            />
            <p class="quiz-preview-eyebrow">{copy.quizEyebrow}</p>
            <h3 class="quiz-preview-title">
              <a href={quiz.href}>{quiz.title}</a>
            </h3>
            <p class="quiz-preview-description">{quiz.description}</p>
            <a class="quiz-preview-link" href={quiz.href}>
              {copy.takeQuiz}
            </a>
          </article>
        ))
      }
    </div>
  </section>

  {
    recentPosts.length > 0 && (
      <section
        class="blog-preview-section"
        aria-labelledby="blog-preview-heading"
      >
        <h2 id="blog-preview-heading" class="section-title">
          {copy.articlesHeading}
        </h2>
        <div class="blog-preview-grid">
          {recentPosts.map((post) => (
            <BlogPostCard
              locale="en"
              id={post.id}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              body={post.body}
              cover={post.data.cover}
            />
          ))}
        </div>
      </section>
    )
  }

  <FAQ
    items={copy.faqItems}
    heading={copy.faqHeading}
    class="faq-section--home"
  />
</AppLayout>
